  "convexCronJobs": [
    {
      "cadence": "{ hours: 1 }",
      "name": "api idempotency cleanup",
      "target": "internal.platform.idempotency.cleanupExpiredInternal"
    },
    {
      "cadence": "{ minutes: 1 }",
      "name": "automation scheduler",
      "target": "internal.automations.automationRunner.runMinuteTick"
    },
    {
      "cadence": "{ minutes: 1 }",
      "name": "daytona workspace reconciliation",
      "target": "internal.ai.sandbox.daytonaReconcile.runMinuteTick"
    },
    {
      "cadence": "{ minutes: 30 }",
      "name": "empty conversation cleanup",
      "target": "internal.chat.conversations.runEmptyConversationCleanup"
    },
    {
      "cadence": "{ hours: 6 }",
      "name": "orphan message delta cleanup",
      "target": "internal.chat.conversations.runOrphanDeltaCleanup"
    },
    {
      "cadence": "{ minutes: 1 }",
      "name": "outbound webhook delivery",
      "target": "internal.webhooks.deliveryRunner.runMinuteTick"
    },
    {
      "cadence": "{ hours: 1 }",
      "name": "service auth replay nonce cleanup",
      "target": "internal.auth.serviceAuth.cleanupExpiredReplayNoncesInternal"
    },
    {
      "cadence": "{ minutes: 2 }",
      "name": "stale generating message cleanup",
      "target": "internal.chat.conversations.runStaleGeneratingCleanup"
    }
  ],
