      "cadence": "{ minutes: 30 }",
      "name": "empty conversation cleanup",
      "target": "internal.chat.conversations.runEmptyConversationCleanup"
    },
    {
      "cadence": "{ minutes: 1 }",
      "name": "outbound webhook delivery",
      "target": "internal.webhooks.deliveryRunner.runMinuteTick"
    },
    {
      "cadence": "{ hours: 1 }",
      "name": "service auth replay nonce cleanup",
      "target": "internal.auth.serviceAuth.cleanupExpiredReplayNoncesInternal"
    },
    {
      "cadence": "{ minutes: 2 }",
      "name": "tool loop agent run lease cleanup",
      "target": "internal.chat.conversations.expireToolLoopAgentRunLeases"
    },
    {
      "cadence": "{ minutes: 1 }",
      "name": "transactional email delivery",
      "target": "internal.email.deliveryRunner.runMinuteTick"
    },
    {
      "cadence": "{ minutes: 5 }",
