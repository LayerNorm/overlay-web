FROM node:22-bookworm AS builder
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_OUTPUT_MODE=standalone

# NEXT_PUBLIC_* values are inlined into the built bundle. Self-hosted
# deployments must pass their own values at image build time; the image cannot
# be repointed at a different Convex URL or app origin at runtime. Defaults
# point the published image at Overlay's hosted backend.
ARG NEXT_PUBLIC_CONVEX_URL=https://colorful-chickadee-419.convex.cloud
ARG NEXT_PUBLIC_APP_URL=https://getoverlay.io
ENV NEXT_PUBLIC_CONVEX_URL=${NEXT_PUBLIC_CONVEX_URL}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}

# Build-time placeholder values: the production config schema validates these
# during static prerendering (sign-in page config resolution). They exist only
# in the builder stage — the published image's runtime env supplies real values.
ENV INTERNAL_API_SECRET=build-time-placeholder-api \
    INTERNAL_SERVICE_AUTH_SECRET=build-time-placeholder-service \
    STRIPE_SECRET_KEY=sk_live_buildplaceholder \
    STRIPE_WEBHOOK_SECRET=whsec_buildplaceholder \
    WORKOS_CLIENT_ID=build-time-placeholder \
    WORKOS_API_KEY=build-time-placeholder \
    SESSION_SECRET=build-time-placeholder \
    SESSION_TRANSFER_KEY=build-time-placeholder \
    SESSION_COOKIE_ENCRYPTION_KEY=build-time-placeholder

COPY .npmrc package.json package-lock.json ./
COPY packages ./packages
RUN npm ci --include=dev --no-audit --no-fund \
  --fetch-retries=5 \
  --fetch-retry-mintimeout=20000 \
  --fetch-retry-maxtimeout=120000

COPY . .
RUN touch .env.better-auth.local
RUN npm run build

FROM scratch AS rds-ca
ADD https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /aws-rds-global-bundle.pem

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV NODE_EXTRA_CA_CERTS=/app/aws-rds-global-bundle.pem

COPY --from=rds-ca --chmod=0444 /aws-rds-global-bundle.pem /app/aws-rds-global-bundle.pem
RUN test -s /app/aws-rds-global-bundle.pem

COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/.next/standalone ./

# The one-off Better Auth migration role uses the same immutable release image.
# Keep its source and build-time dependencies in this enterprise image until the
# migration runner is emitted as a standalone bundle.
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/packages ./packages
COPY --from=builder --chown=node:node /app/scripts ./scripts
COPY --from=builder --chown=node:node /app/src ./src
COPY --from=builder --chown=node:node /app/tsconfig.json ./tsconfig.json
COPY --from=builder --chown=node:node /app/package.json ./package.json

USER node
EXPOSE 3000
CMD ["node", "server.js"]
