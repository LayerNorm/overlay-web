    "report:web-complexity": "node scripts/ci/report-web-complexity.mjs",
    "check:web-complexity": "node scripts/ci/report-web-complexity.mjs --check --no-html",
    "check:shared-isomorphic": "node scripts/ci/enforce-shared-isomorphic.mjs",
    "check:raw-controls": "node scripts/ci/check-raw-controls.mjs",
    "check:chat-legacy-imports": "node scripts/ci/check-chat-legacy-imports.mjs",
    "check:native-architecture": "node scripts/ci/check-native-architecture.mjs",
    "check:vendor-boundaries": "node scripts/ci/check-no-vendor-imports-in-routes.mjs",
    "check:files-route-boundary": "node scripts/ci/check-files-route-boundary.mjs",
    "check:domain-service-boundaries": "node scripts/ci/check-domain-service-boundaries.mjs",
    "check:tenant-boundaries": "tsx scripts/ci/check-tenant-boundaries.ts",
    "check:admin-separation": "tsx scripts/ci/check-admin-separation.ts",
    "license:check": "tsx scripts/ci/check-licensing.ts",
    "test:route-characterization": "NEXT_PUBLIC_CONVEX_URL=https://fixture.convex.cloud INTERNAL_API_SECRET=test-internal-secret NODE_OPTIONS=--require=./scripts/ci/register-server-only.cjs tsx --test src/server/files/FileService.test.ts src/server/automations/AutomationService.test.ts src/server/billing/BillingCustomerService.test.ts src/server/conversations/ActConversationService.test.ts src/server/app-api/v1/route-characterization.test.ts",
    "test:lifecycle-events": "NODE_OPTIONS=--require=./scripts/ci/register-server-only.cjs tsx --test src/server/lifecycle-events/LifecycleEventPublisher.test.ts src/server/users/UserService.test.ts src/server/automations/AutomationService.test.ts",
    "test:mirror": "node --test examples/customer-deployment/mirror/*.test.mjs",
    "test:observability": "NODE_OPTIONS=--require=./scripts/ci/register-server-only.cjs tsx --test src/server/capabilities.test.ts src/server/observability/context.test.ts src/server/observability/logger.test.ts src/server/observability/posthog-server.test.ts src/shared/security/sentry-sanitize.test.ts src/shared/security/safe-url.test.ts",
    "test:release-safety": "NODE_OPTIONS=--require=./scripts/ci/register-server-only.cjs tsx --test src/server/app-api/public-route-security.test.ts src/server/security/browser-mutation-origin.test.ts",
    "check:providers": "NEXT_PUBLIC_CONVEX_URL=https://fixture.convex.cloud NODE_OPTIONS=--require=./scripts/ci/register-server-only.cjs tsx --test src/server/bootstrap.test.ts src/server/auth/better-auth.test.ts src/server/auth/providers/oidc-auth-provider.test.ts && bun run check:vendor-boundaries",
    "test:phase6-routes": "NEXT_PUBLIC_CONVEX_URL=https://fixture.convex.cloud NODE_OPTIONS=--conditions=react-server tsx --test src/server/phase6-release-gates.test.ts",
    "check:phase6": "tsx scripts/ci/check-phase6-release-gates.ts",
    "check:config": "NODE_OPTIONS=--conditions=react-server tsx --test src/shared/config/overlayConfigSchema.test.ts src/server/config/loadOverlayConfig.test.ts src/server/auth/connections/preset-registry.test.ts && NODE_OPTIONS=--conditions=react-server tsx scripts/ci/check-overlay-config.ts",
