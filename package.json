    "p5:backup:verify": "NODE_OPTIONS=--conditions=react-server tsx scripts/p5-backup-restore-drill.ts --mode=verify",
    "p5:capacity:baseline": "NODE_OPTIONS=--conditions=react-server tsx scripts/p5-capacity-cost-baseline.ts",
    "check:p5d:remote": "npm run test:p5d:postgres:remote && NODE_OPTIONS=--conditions=react-server tsx --test src/server/database/postgres/schema-compatibility.test.ts && npm run docs:health",
    "test:p6:unit": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/app-data/capabilities.test.ts src/server/automations/AutomationEntitlementPolicy.test.ts src/server/automations/AutomationSchedule.test.ts src/server/automations/AutomationService.test.ts src/server/security/ssrf.test.ts src/server/webhooks/PostgresWebhookDeliveryService.test.ts packages/overlay-app-core/src/capabilities.test.ts packages/overlay-api-client/src/index.test.ts",
    "test:p6:ui": "tsx scripts/p6-automation-ui-qa.ts",
    "test:p6:postgres:remote": "npm run app-db:contract:migrate && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local --test --test-concurrency=1 src/server/app-data/contracts/postgres-automations.test.ts src/server/app-data/contracts/postgres-automation-runtime.test.ts src/server/app-data/contracts/postgres-webhooks.test.ts src/server/app-data/contracts/postgres-daytona-reconciliation.test.ts",
    "test:p6:contracts:postgres:remote": "npm run app-db:contract:migrate && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local --test --test-concurrency=1 src/server/app-data/contracts/postgres-automation-webhook-contract.test.ts",
    "test:p6:contracts:convex": "NODE_ENV=development APP_DATA_CONTRACT_CONVEX=1 NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.development.local --test src/server/app-data/contracts/convex-automation-webhook-contract.test.ts",
    "test:p7:postgres:remote": "npm run app-db:contract:migrate && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local --test --test-concurrency=1 src/server/app-data/contracts/postgres-usage-accounting.test.ts",
    "test:p7d:postgres:remote": "npm run app-db:contract:migrate && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local --test --test-concurrency=1 src/server/app-data/contracts/postgres-billing.test.ts",
