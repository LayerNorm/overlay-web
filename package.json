    "test:p7g:postgres:remote": "npm run app-db:contract:migrate && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local --test --test-concurrency=1 src/server/app-data/contracts/postgres-p7-provider-contract.test.ts src/server/app-data/contracts/postgres-p7-faults.test.ts",
    "test:p7g:convex": "NODE_ENV=development APP_DATA_CONTRACT_CONVEX=1 NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.development.local --test src/server/app-data/contracts/convex-p7-provider-contract.test.ts",
    "test:p7g:ui": "NODE_OPTIONS=--conditions=react-server tsx scripts/p7-ui-qa.ts",
    "test:p7i:postgres:remote": "npm run app-db:contract:migrate && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local --test --test-concurrency=1 src/server/app-data/contracts/postgres-skills-mcp-contract.test.ts src/server/extensions/McpCredentialCipher.test.ts",
    "test:p7i:convex": "NODE_ENV=development APP_DATA_CONTRACT_CONVEX=1 NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.development.local --test src/server/app-data/contracts/convex-skills-mcp-contract.test.ts",
    "test:p7i:ui": "NODE_OPTIONS=--conditions=react-server tsx scripts/p7i-ui-qa.ts",
    "test:p7j:contracts": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/integrations/integration-provider-contract.test.ts",
    "test:p7:unit": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/billing/billing-runtime.test.ts src/server/outputs/GenerationUsagePolicy.test.ts src/server/conversations/ActConversationService.test.ts src/server/app-data/capabilities.test.ts src/server/app-data/route-support.test.ts",
    "check:p7:remote": "npm run test:p7:unit && npm run test:p7:postgres:remote && npm run test:p7d:postgres:remote && npm run test:p7e:postgres:remote && npm run test:p7f:postgres:remote && npm run test:p7g:postgres:remote && npm run test:p7i:postgres:remote && npm run test:on-prem:no-convex-server && npm run check:on-prem-parity",
    "aws:rehearsal:6": "NODE_OPTIONS=--conditions=react-server tsx scripts/app-data-migrate.ts && NODE_OPTIONS=--conditions=react-server tsx --test --test-concurrency=1 src/server/app-data/contracts/postgres-automation-webhook-contract.test.ts src/server/app-data/contracts/postgres-automation-runtime.test.ts src/server/app-data/contracts/postgres-webhooks.test.ts src/server/app-data/contracts/postgres-daytona-reconciliation.test.ts && NODE_OPTIONS=--conditions=react-server tsx scripts/aws-rehearsal-6-readiness.ts",
