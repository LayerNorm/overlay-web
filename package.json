    "test:p5c:postgres:remote": "npm run test:p4e:postgres:remote && npm run test:app-data-contracts:postgres:remote && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local scripts/app-data-deletion-audit.ts",
