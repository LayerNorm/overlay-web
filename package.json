    "check:p6:remote": "npm run test:p6:unit && npm run test:p6:postgres:remote && npm run test:p6:contracts:postgres:remote && npm run test:on-prem:no-convex-server && npm run check:on-prem-parity && npm run docs:health",
    "build": "next build",
    "analyze": "NEXT_DIST_DIR=.next-analyze ANALYZE=true SENTRY_AUTH_TOKEN= SENTRY_ORG= SENTRY_PROJECT= next build && node scripts/check-bundle-budgets.mjs --dist-dir=.next-analyze --require-analyzer",
    "check:bundle-budgets": "node scripts/check-bundle-budgets.mjs",
    "start": "next start",
    "lint": "eslint",
    "check:chat-transcript-boundaries": "node packages/overlay-chat-react/scripts/check-transcript-boundaries.mjs && TSX_TSCONFIG_PATH=tsconfig.json node --import tsx --test src/features/chat/components/chat/toChatTranscriptView.test.ts",
