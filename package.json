{
  "name": "getoverlay-landing",
  "version": "0.1.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "convex:push:prod": "CONVEX_DEPLOYMENT=prod:colorful-chickadee-419 convex deploy -y",
    "convex:push:dev": "convex deploy --env-file .env.development.local -y",
    "convex:push:all": "npm run convex:push:prod && npm run convex:push:dev",
    "convex:deploy": "npm run convex:push:prod",
    "convex:deploy:dev": "npm run convex:push:dev",
    "convex:deploy:all": "npm run convex:push:all",
    "dev": "next dev",
    "dev:with-convex": "npm run convex:push:dev && next dev",
    "dev:better-auth": "node --env-file=.env.better-auth.local node_modules/next/dist/bin/next dev",
    "better-auth:db:up": "docker compose --env-file .env.better-auth.local -f docker-compose.better-auth.yml up -d",
    "better-auth:db:down": "docker compose --env-file .env.better-auth.local -f docker-compose.better-auth.yml down",
    "better-auth:db:logs": "docker compose --env-file .env.better-auth.local -f docker-compose.better-auth.yml logs -f better-auth-postgres",
    "better-auth:migrate": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.better-auth.local scripts/better-auth-migrate.ts",
    "app-db:up": "docker compose --env-file .env.app-data.local -f docker-compose.app-data.yml up -d --wait",
    "app-db:down": "docker compose --env-file .env.app-data.local -f docker-compose.app-data.yml down",
    "app-db:logs": "docker compose --env-file .env.app-data.local -f docker-compose.app-data.yml logs -f app-data-postgres",
    "app-db:generate": "drizzle-kit generate --config=drizzle.app-data.config.ts",
    "app-db:migrate": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.app-data.local scripts/app-data-migrate.ts",
    "app-db:maintenance": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.app-data.local scripts/app-data-maintenance.ts",
    "app-db:smoke": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.app-data.local scripts/app-data-smoke.ts",
    "app-db:vector-readiness": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.app-data.local scripts/app-data-vector-readiness.ts",
    "app-db:account-delete-smoke": "NODE_OPTIONS=--conditions=react-server tsx scripts/app-data-account-delete-smoke.ts",
    "app-db:worker": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.app-data.local scripts/app-data-worker.ts --mode=all",
    "app-db:worker:once": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.app-data.local scripts/app-data-worker.ts --mode=worker --once",
    "app-db:worker:smoke": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.app-data.local scripts/app-data-worker.ts --mode=worker --once --healthcheck",
    "app-db:scheduler:once": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.app-data.local scripts/app-data-worker.ts --mode=scheduler --once",
    "test:app-data-contracts:postgres": "npm run app-db:up && npm run app-db:migrate && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.app-data.local --test src/server/app-data/contracts/postgres-contract.test.ts",
    "test:app-data-contracts:convex": "NODE_ENV=development APP_DATA_CONTRACT_CONVEX=1 NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.development.local --test src/server/app-data/contracts/convex-contract.test.ts",
    "test:app-data-contracts": "npm run test:app-data-contracts:postgres && npm run test:app-data-contracts:convex",
    "report:on-prem-parity": "NODE_OPTIONS=--conditions=react-server tsx scripts/report-on-prem-parity.ts",
    "check:on-prem-convex-boundaries": "tsx scripts/check-on-prem-convex-boundaries.ts",
    "test:on-prem:no-convex-server": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/app-data/no-convex-runtime.test.ts",
    "test:on-prem:no-convex-browser": "tsx scripts/on-prem-browser-no-convex-smoke.ts",
    "check:on-prem-parity": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/app-data/parity-matrix.test.ts src/server/app-data/route-support.test.ts src/server/app-data/no-convex-runtime.test.ts && npm run check:on-prem-convex-boundaries",
    "test:p1:unit": "NODE_OPTIONS=--require=./scripts/register-server-only.cjs tsx --test src/server/app-api/idempotency.test.ts src/server/shared/providers/redis-rate-limiter.test.ts",
    "test:p1:postgres": "npm run app-db:up && npm run app-db:migrate && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.app-data.local --test src/server/app-data/contracts/postgres-runtime-foundations.test.ts",
    "test:p1:redis": "npm run app-db:up && OVERLAY_REDIS_URL=redis://localhost:56379 NODE_OPTIONS=--require=./scripts/register-server-only.cjs tsx --test src/server/shared/providers/redis-rate-limiter.test.ts",
    "check:p1": "npm run test:p1:unit && npm run test:p1:postgres && npm run test:p1:redis && npm run check:on-prem-parity",
    "build": "next build",
    "analyze": "NEXT_DIST_DIR=.next-analyze ANALYZE=true SENTRY_AUTH_TOKEN= SENTRY_ORG= SENTRY_PROJECT= next build && node scripts/check-bundle-budgets.mjs --dist-dir=.next-analyze --require-analyzer",
    "check:bundle-budgets": "node scripts/check-bundle-budgets.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ui:typecheck": "npm --prefix packages/overlay-ui run typecheck",
    "ui:test": "npm --prefix packages/overlay-ui run test",
    "ui:storybook": "npm --prefix packages/overlay-ui run storybook",
    "api-client:typecheck": "npm --prefix packages/overlay-api-client run typecheck",
    "api-client:test": "npm --prefix packages/overlay-api-client run test",
    "app-core:typecheck": "npm --prefix packages/overlay-app-core run typecheck",
    "app-core:test": "npm --prefix packages/overlay-app-core run test",
    "extension-sdk:typecheck": "npm --prefix packages/overlay-extension-sdk run typecheck",
    "extension-sdk:test": "npm --prefix packages/overlay-extension-sdk run test",
    "billing:typecheck": "npm --prefix packages/overlay-billing run typecheck",
    "billing:test": "npm --prefix packages/overlay-billing run test",
    "chat-core:typecheck": "npm --prefix packages/overlay-chat-core run typecheck",
    "chat-react:typecheck": "npm --prefix packages/overlay-chat-react run typecheck",
    "modules-react:typecheck": "npm --prefix packages/overlay-modules-react run typecheck",
    "check:module-boundaries": "node scripts/ensure-module-presentational-boundaries.mjs",
    "report:web-complexity": "node scripts/report-web-complexity.mjs",
    "check:web-complexity": "node scripts/report-web-complexity.mjs --check --no-html",
    "check:shared-isomorphic": "node scripts/enforce-shared-isomorphic.mjs",
    "check:vendor-boundaries": "node scripts/check-no-vendor-imports-in-routes.mjs",
    "check:files-route-boundary": "node scripts/check-files-route-boundary.mjs",
    "check:domain-service-boundaries": "node scripts/check-domain-service-boundaries.mjs",
    "check:tenant-boundaries": "tsx scripts/check-tenant-boundaries.ts",
    "license:check": "tsx scripts/check-licensing.ts",
    "test:route-characterization": "NEXT_PUBLIC_CONVEX_URL=https://fixture.convex.cloud INTERNAL_API_SECRET=test-internal-secret NODE_OPTIONS=--require=./scripts/register-server-only.cjs tsx --test src/server/files/FileService.test.ts src/server/automations/AutomationService.test.ts src/server/billing/BillingCustomerService.test.ts src/server/billing/BillingCheckoutService.test.ts src/server/conversations/ActConversationService.test.ts src/server/app-api/v1/route-characterization.test.ts",
    "check:providers": "NEXT_PUBLIC_CONVEX_URL=https://fixture.convex.cloud NODE_OPTIONS=--conditions=react-server tsx --test src/server/bootstrap.test.ts src/server/auth/providers/oidc-auth-provider.test.ts && npm run check:vendor-boundaries",
    "test:phase6-routes": "NEXT_PUBLIC_CONVEX_URL=https://fixture.convex.cloud NODE_OPTIONS=--conditions=react-server tsx --test src/server/phase6-release-gates.test.ts",
    "check:phase6": "tsx scripts/check-phase6-release-gates.ts",
    "check:config": "NODE_OPTIONS=--conditions=react-server tsx --test src/shared/config/overlayConfigSchema.test.ts src/server/config/loadOverlayConfig.test.ts && NODE_OPTIONS=--conditions=react-server tsx scripts/check-overlay-config.ts",
    "docs:dev": "npm run docs:generate:api && cd docs && node ../scripts/run-mint.mjs dev --no-open",
    "docs:generate:api": "tsx scripts/generate-web-api-openapi.ts",
    "docs:health": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-docs-health.ts",
    "docs:update": "npm run docs:generate:api && npm run docs:health",
    "docs:check": "npm run docs:generate:api && npm run docs:health && cd docs && node ../scripts/run-mint.mjs validate && node ../scripts/run-mint.mjs broken-links --check-anchors",
    "docs:check:self-hosting": "npm run docs:health",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "video:studio": "npx remotion studio src/remotion/index.ts",
    "video:render:launch": "mkdir -p renders && npx remotion render src/remotion/index.ts overlay-launch-video renders/overlay-launch-video.mp4",
    "test:auth:env": "node --experimental-strip-types scripts/auth-dev-env-check.ts",
    "test:auth:convex": "node --experimental-strip-types scripts/auth-convex-debug.ts",
    "test:auth:cookie": "node --experimental-strip-types scripts/auth-cookie-inspect.ts",
    "test:auth:refresh": "node --experimental-strip-types scripts/auth-refresh-check.ts",
    "test:automations": "tsx --test packages/overlay-app-core/src/automations.test.ts",
    "test:billing": "node --test --experimental-strip-types src/shared/billing/billing-pricing.test.ts",
    "test:pricing": "tsx --test src/server/ai/gateway/model-pricing.test.ts",
    "test:gateway-contracts": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/ai/gateway/gateway-runtime.test.ts src/server/ai/gateway/gateway-search-tools.test.ts src/server/ai/gateway/openrouter-service.test.ts src/server/ai/gateway/tool-schema-compat.test.ts src/server/tools/tools/build.test.ts src/server/app-api/v1/conversations/act/tooling.test.ts",
    "test:gateway-canary": "NODE_OPTIONS=--conditions=react-server tsx scripts/vercel-ai-gateway-canary.ts",
    "test:chat-history": "node --test --experimental-strip-types src/server/chat/chat-history-persistence.test.ts",
    "test:file-text-search": "tsx --test src/shared/storage/file-text-search.test.ts",
    "test:daytona:smoke": "node --env-file=.env.local --experimental-strip-types scripts/daytona-tool-smoke.ts",
    "test:daytona:reconcile:smoke": "node --env-file=.env.local --experimental-strip-types scripts/daytona-reconcile-smoke.ts",
    "test:unified-tools": "NODE_OPTIONS=--conditions=react-server node --experimental-strip-types scripts/unified-tools-sanity.ts",
    "convex:audit:storage": "node --experimental-strip-types scripts/convex-storage-audit.ts",
    "convex:backfill:storage": "node --experimental-strip-types scripts/convex-storage-backfill.ts",
    "convex:backfill:filesystem": "node --experimental-strip-types scripts/backfill-canonical-filesystem.ts",
    "convex:reindex:knowledge": "node --experimental-strip-types scripts/convex-knowledge-reindex.ts",
    "chat-stream:dev": "npm --prefix workers/chat-stream run dev",
    "chat-stream:deploy": "npm --prefix workers/chat-stream run deploy",
    "test:chat-stream-worker": "npm --prefix workers/chat-stream run typecheck",
    "test:jwt": "node --env-file=../overlay-desktop/.env.local --experimental-strip-types scripts/smoke-jwt.ts",
    "test:r2:connectivity": "node --env-file=.env.local --experimental-strip-types scripts/smoke-r2-connectivity.ts",
    "test:r2:presign": "node --env-file=.env.local --experimental-strip-types scripts/smoke-r2-presign.ts",
    "test:r2:presign:prod-origin": "R2_CORS_ORIGIN=https://www.getoverlay.io node --env-file=.env.local --experimental-strip-types scripts/smoke-r2-presign.ts",
    "test:r2:budget": "node --env-file=.env.local --experimental-strip-types scripts/smoke-r2-budget.ts",
    "r2:cors:apply:dev": "npx wrangler r2 bucket cors set overlay-dev --file config/r2-cors.json",
    "test:vault:smoke": "node --env-file=../overlay-desktop/.env.local --experimental-strip-types scripts/smoke-vault.ts",
    "stripe:setup:variable-pricing": "node --env-file=.env.local --experimental-strip-types scripts/stripe-variable-pricing-setup.ts",
    "billing:migrate:staging": "node --env-file=.env.local --experimental-strip-types scripts/variable-pricing-migration.ts",
    "billing:audit:stripe": "node --experimental-strip-types scripts/stripe-dynamic-pricing-audit.ts",
    "test:auth:native-validation": "NODE_OPTIONS=--conditions=react-server node --test --experimental-strip-types src/server/auth/native-auth-validation.test.ts src/server/auth/native-refresh-rate-limit.test.ts",
    "test:auth:native-smoke": "node --env-file=.env.local --experimental-strip-types scripts/native-auth-security-smoke.ts",
    "test:auth:better-auth-negative": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.better-auth.local scripts/better-auth-negative-security-smoke.ts"
  },
