{
  "name": "getoverlay-landing",
  "version": "0.1.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.5",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*",
    "apps/admin",
    "apps/chrome",
    "apps/desktop",
    "apps/mobile"
  ],
  "scripts": {
    "convex:push:prod": "CONVEX_DEPLOYMENT=prod:colorful-chickadee-419 convex deploy -y",
    "convex:push:dev": "convex deploy --env-file .env.development.local -y",
    "convex:push:all": "bun run convex:push:prod && bun run convex:push:dev",
    "convex:deploy": "bun run convex:push:prod",
    "convex:deploy:dev": "bun run convex:push:dev",
    "convex:deploy:all": "bun run convex:push:all",
    "dev": "next dev",
    "admin:dev": "bun run --cwd apps/admin dev",
    "admin:build": "bun run --cwd apps/admin build",
    "admin:typecheck": "bun run --cwd apps/admin typecheck",
    "admin:lint": "bun run --cwd apps/admin lint",
    "admin:test": "bun run --cwd apps/admin test",
    "dev:with-convex": "bun run convex:push:dev && next dev",
    "dev:better-auth": "node --env-file=.env.better-auth.local node_modules/next/dist/bin/next dev",
    "better-auth:db:up": "docker compose -f docker/docker-compose.better-auth.yml up -d --wait",
    "better-auth:db:down": "docker compose -f docker/docker-compose.better-auth.yml down",
    "better-auth:db:logs": "docker compose -f docker/docker-compose.better-auth.yml logs -f better-auth-postgres",
    "better-auth:migrate": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.better-auth.local scripts/db/better-auth-migrate.ts",
    "test:app-data-contracts:convex": "NODE_ENV=development APP_DATA_CONTRACT_CONVEX=1 NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.development.local --test src/server/app-data/contracts/convex-contract.test.ts",
    "test:app-data-contracts": "bun run test:app-data-contracts:convex",
    "check:on-prem-convex-boundaries": "tsx scripts/ci/check-on-prem-convex-boundaries.ts",
    "test:p1:unit": "NODE_OPTIONS=--require=./scripts/ci/register-server-only.cjs tsx --test src/server/app-api/idempotency.test.ts src/server/shared/providers/redis-rate-limiter.test.ts",
    "test:p1:redis": "bun run better-auth:db:up && OVERLAY_REDIS_URL=redis://localhost:56379 NODE_OPTIONS=--require=./scripts/ci/register-server-only.cjs tsx --test src/server/shared/providers/redis-rate-limiter.test.ts",
    "check:p1": "bun run test:p1:unit && bun run test:p1:redis && bun run check:on-prem-convex-boundaries",
    "test:p2:unit": "NODE_OPTIONS=--require=./scripts/ci/register-server-only.cjs tsx --test src/shared/agents/agent-run.test.ts src/server/conversations/tool-loop-run-registry.test.ts",
    "test:local-computer:convex": "vitest run convex/environmentControlPlane.convex.test.ts convex/localToolCalls.convex.test.ts convex/purgeConnectedAgents.convex.test.ts",
    "test:local-computer:security": "OVERLAY_USAGE_MARKUP_BPS=2500 NODE_OPTIONS=--require=./scripts/ci/register-server-only.cjs tsx --test src/server/agents/ConnectedAgentControlPlaneService.test.ts src/server/agents/ManagedAgentSandboxBilling.test.ts src/server/app-api/public-route-security.test.ts src/server/computers/local/local-computer.test.ts",
    "check:local-computer": "bun run test:local-computer:convex && bun run test:local-computer:security && bun run test:agent-bridge-protocol && bun run test:agent-host",
    "check:local-computer:release": "bun run check:local-computer && bun run verify:agent-host-release && bun run pack:agent-host-release && bun run smoke:agent-host-release",
    "test:agent-bridge-protocol": "bun run --cwd packages/overlay-agent-bridge-protocol test",
    "test:agent-host": "bun run --cwd packages/overlay-agent-host test",
    "verify:agent-host-release": "node scripts/ci/verify-agent-host-release.mjs",
    "pack:agent-host-release": "npm pack --dry-run --workspace=@layernorm/overlay-agent-bridge-protocol && npm pack --dry-run --workspace=@layernorm/overlay-agent-host",
    "smoke:agent-host-release": "node scripts/qa/smoke-agent-host-package-install.mjs",
    "test:rooms:convex": "NODE_ENV=development WORKSPACE_CONTRACT_CONVEX=1 NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.development.local --test src/server/conversations/convex-agent-message-stream.test.ts",
    "check:p2": "bun run test:p2:unit && bun run test:app-data-contracts:convex && bun run check:on-prem-convex-boundaries",
    "check:p3a:remote": "bun run test:app-data-contracts:convex && bun run check:on-prem-convex-boundaries",
    "test:p3b:unit": "NODE_OPTIONS=--require=./scripts/ci/register-server-only.cjs tsx --test src/server/files/FileService.test.ts src/server/files/FileServicePayloads.test.ts",
    "check:p3b:remote": "bun run test:p3b:unit && bun run test:app-data-contracts:convex && bun run check:on-prem-convex-boundaries",
    "test:p3c:unit": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/outputs/OutputService.test.ts src/server/outputs/GenerationUsagePolicy.test.ts",
    "test:p3c:convex": "bun run test:app-data-contracts:convex",
    "check:p3c:remote": "bun run test:p3c:unit && bun run test:p3c:convex && bun run check:on-prem-convex-boundaries",
    "test:p4:convex": "bun run test:app-data-contracts:convex",
    "check:p4:remote": "bun run check:config && bun run test:p4:convex && bun run check:on-prem-convex-boundaries",
    "test:p4e:convex": "NODE_ENV=development KNOWLEDGE_CHARACTERIZATION_CONVEX=1 NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.development.local --test src/server/app-data/contracts/convex-knowledge-characterization.test.ts",
    "check:p4e:remote": "bun run test:p4e:convex && bun run check:on-prem-convex-boundaries",
    "test:p5c:security": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/auth/session-cookie-signature.test.ts src/server/auth/session-transfer-crypto.test.ts src/server/storage/providers/s3-compatible-object-store.test.ts src/server/files/FileService.test.ts",
    "check:p5c:remote": "bun run test:p5c:security && bun run check:on-prem-convex-boundaries",
    "test:p6:unit": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/automations/AutomationEntitlementPolicy.test.ts src/server/automations/AutomationSchedule.test.ts src/server/automations/AutomationService.test.ts src/server/security/ssrf.test.ts packages/overlay-app-core/src/capabilities.test.ts packages/overlay-api-client/src/index.test.ts",
    "test:p6:ui": "tsx scripts/qa/p6-automation-ui-qa.ts",
    "test:p6:contracts:convex": "NODE_ENV=development APP_DATA_CONTRACT_CONVEX=1 NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.development.local --test src/server/app-data/contracts/convex-automation-webhook-contract.test.ts",
    "test:workspace-billing-contract:convex": "NODE_ENV=development APP_DATA_CONTRACT_CONVEX=1 NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.development.local --test --test-concurrency=1 src/server/app-data/contracts/convex-workspace-billing-provider-contract.test.ts",
    "test:p7g:convex": "NODE_ENV=development APP_DATA_CONTRACT_CONVEX=1 NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.development.local --test src/server/app-data/contracts/convex-p7-provider-contract.test.ts",
    "test:p7g:ui": "NODE_OPTIONS=--conditions=react-server tsx scripts/qa/p7-ui-qa.ts",
    "test:p7i:convex": "NODE_ENV=development APP_DATA_CONTRACT_CONVEX=1 NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.development.local --test src/server/app-data/contracts/convex-skills-mcp-contract.test.ts",
    "test:p7i:ui": "NODE_OPTIONS=--conditions=react-server tsx scripts/qa/p7i-ui-qa.ts",
    "test:p7j:contracts": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/integrations/integration-provider-contract.test.ts",
    "test:p7:unit": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/app-api/bff-context.test.ts src/server/billing/billing-runtime.test.ts src/server/billing/automation-workflow-billing.test.ts src/server/billing/billable-feature-coverage.test.ts src/server/outputs/GenerationUsagePolicy.test.ts src/server/conversations/ActConversationService.test.ts",
    "check:p7:remote": "bun run test:p7:unit && bun run test:p7g:convex && bun run test:p7i:convex && bun run check:on-prem-convex-boundaries",
    "aws:byok:secrets:smoke": "tsx scripts/qa/aws-byok-secrets-smoke.ts",
    "check:p6:remote": "bun run test:p6:unit && bun run test:p6:contracts:convex && bun run check:on-prem-convex-boundaries && bun run docs:health",
    "build": "next build --webpack",
    "analyze": "NEXT_DIST_DIR=.next-analyze ANALYZE=true SENTRY_AUTH_TOKEN= SENTRY_ORG= SENTRY_PROJECT= next build --webpack && node scripts/ci/check-bundle-budgets.mjs --dist-dir=.next-analyze --require-analyzer",
    "check:bundle-budgets": "node scripts/ci/check-bundle-budgets.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:all": "node scripts/ci/run-all-tests.mjs",
    "test:integration": "node scripts/ci/run-all-tests.mjs --integration",
    "check:chat-transcript-boundaries": "node packages/overlay-chat-react/scripts/check-transcript-boundaries.mjs && TSX_TSCONFIG_PATH=tsconfig.json node --import tsx --test src/features/chat/components/chat/toChatTranscriptView.test.ts src/shared/knowledge/source-citations.test.ts src/shared/knowledge/knowledge-sources.test.ts src/server/app-api/v1/link-preview/embeddable.test.ts && TSX_TSCONFIG_PATH=packages/overlay-chat-core/tsconfig.json node --import tsx --test packages/overlay-chat-core/src/sources.snippet.test.ts && bun run --cwd packages/overlay-chat-react test",
    "check:file-parity-boundaries": "node scripts/ci/check-file-parity-boundaries.mjs",
    "check:knowledge-surface-contract": "node scripts/ci/check-knowledge-surface-contract.mjs && node --import tsx --test src/features/knowledge/adapters/webKnowledgeSurfaceAdapters.test.ts && node --import tsx --test packages/overlay-modules-react/src/knowledge/surface.test.tsx packages/overlay-modules-react/src/knowledge/file-viewer.test.tsx",
    "chat-parity:manifest": "node scripts/ci/chat-parity-baseline-manifest.mjs",
    "file-parity:manifest": "node scripts/ci/file-parity-baseline-manifest.mjs",
    "check:desktop-provider-key-boundary": "NODE_OPTIONS=--require=./scripts/ci/register-server-only.cjs tsx --test src/server/ai/gateway/hosted-provider-kill-switch.test.ts && node scripts/ci/check-desktop-provider-key-boundary.mjs",
    "typecheck": "bun run check:desktop-provider-key-boundary && bun run check:chat-transcript-boundaries && bun run check:file-parity-boundaries && bun run check:knowledge-surface-contract && node scripts/ci/typecheck-native.mjs",
