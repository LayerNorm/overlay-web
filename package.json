    "perf:baseline:test": "node --test scripts/qa/perf-baseline-lib.test.mjs",
    "perf:bundle": "node scripts/qa/bundle-baseline.mjs --dist-dir=.next-analyze",
    "docs:health": "NODE_OPTIONS=--conditions=react-server tsx scripts/ci/check-docs-health.ts",
    "docs:update": "bun run docs:generate:api && bun run docs:health",
    "docs:check": "bun run docs:generate:api && bun run docs:health && cd docs && node ../scripts/ci/run-mint.mjs validate && node ../scripts/ci/run-mint.mjs broken-links --check-anchors",
