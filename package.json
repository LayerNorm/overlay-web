    "app-db:contract:migrate": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local scripts/app-data-migrate.ts",
    "app-db:admin": "NODE_OPTIONS=--conditions=react-server tsx scripts/app-data-admin.ts",
    "app-db:contract:smoke": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local scripts/app-data-smoke.ts",
    "app-db:maintenance": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.app-data.local scripts/app-data-maintenance.ts",
