    "ui:test": "bun run --cwd packages/overlay-ui test",
    "ui:storybook": "bun run --cwd packages/overlay-ui storybook",
    "api-client:typecheck": "bun run --cwd packages/overlay-api-client typecheck",
    "api-client:test": "bun run --cwd packages/overlay-api-client test",
    "app-core:typecheck": "bun run --cwd packages/overlay-app-core typecheck",
    "app-core:test": "bun run --cwd packages/overlay-app-core test",
    "extension-sdk:typecheck": "bun run --cwd packages/overlay-extension-sdk typecheck",
    "extension-sdk:test": "bun run --cwd packages/overlay-extension-sdk test",
    "billing:typecheck": "bun run --cwd packages/overlay-billing typecheck",
    "billing:test": "bun run --cwd packages/overlay-billing test",
    "chat-core:typecheck": "bun run --cwd packages/overlay-chat-core typecheck",
    "chat-react:typecheck": "bun run --cwd packages/overlay-chat-react typecheck",
    "modules-react:typecheck": "bun run --cwd packages/overlay-modules-react typecheck",
