    "test:p4d:postgres:remote": "npm run app-db:contract:migrate && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local --test src/server/app-data/contracts/postgres-knowledge-lifecycle.test.ts",
    "check:p4d:remote": "npm run test:p4d:postgres:remote && npm run test:p4:postgres:remote && npm run check:on-prem-parity",
    "test:p4e:postgres": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/app-data/contracts/postgres-knowledge-characterization.test.ts",
