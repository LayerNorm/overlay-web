    "test:p1:unit": "NODE_OPTIONS=--require=./scripts/register-server-only.cjs tsx --test src/server/app-api/idempotency.test.ts src/server/database/postgres/transient-errors.test.ts src/server/conversations/PostgresConversationEventNotifier.test.ts src/server/jobs/PostgresJobWorker.test.ts src/server/shared/providers/redis-rate-limiter.test.ts",
    "test:p1:postgres": "npm run app-db:up && npm run app-db:migrate && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.app-data.local --test src/server/app-data/contracts/postgres-runtime-foundations.test.ts",
    "test:p1:postgres:remote": "npm run app-db:contract:migrate && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local --test src/server/app-data/contracts/postgres-runtime-foundations.test.ts",
    "test:p1:redis": "npm run app-db:up && OVERLAY_REDIS_URL=redis://localhost:56379 NODE_OPTIONS=--require=./scripts/register-server-only.cjs tsx --test src/server/shared/providers/redis-rate-limiter.test.ts",
    "check:p1": "npm run test:p1:unit && npm run test:p1:postgres && npm run test:p1:redis && npm run check:on-prem-parity",
    "test:p2:unit": "NODE_OPTIONS=--require=./scripts/register-server-only.cjs tsx --test src/server/conversations/chat-stream-persistence.test.ts src/features/chat/components/chat/chatStreamResume.test.ts",
    "test:p2:postgres": "npm run test:app-data-contracts:postgres",
    "test:p2:postgres:remote": "npm run test:app-data-contracts:postgres:remote",
    "check:p2": "npm run test:p2:unit && npm run test:p2:postgres && npm run check:on-prem-parity && npm run test:on-prem:no-convex-browser",
    "test:p3a:unit": "NODE_OPTIONS=--require=./scripts/register-server-only.cjs tsx --test src/server/projects/ProjectService.test.ts",
