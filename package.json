    "test:p5b:postgres:remote": "npm run app-db:contract:migrate && NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local --test src/server/app-data/contracts/postgres-resilience.test.ts",
    "check:p5:remote": "npm run check:config && npm run test:p4:postgres:remote && npm run test:p4:convex && npm run test:p4d:postgres:remote && npm run test:p4e:postgres:remote && npm run test:p4e:convex && npm run test:p5b:postgres:remote && npm run check:on-prem-parity",
