    "app-db:contract:knowledge-backfill": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.on-prem-contract-tests.local scripts/app-data-knowledge-backfill.ts",
    "app-db:account-delete-smoke": "NODE_OPTIONS=--conditions=react-server tsx scripts/app-data-account-delete-smoke.ts",
