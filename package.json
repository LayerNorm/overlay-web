    "check:p3a:remote": "npm run test:p3a:unit && npm run test:p3a:postgres:remote && npm run check:on-prem-parity",
    "test:p3b:unit": "NODE_OPTIONS=--require=./scripts/register-server-only.cjs tsx --test src/server/files/FileService.test.ts src/server/files/FileServicePayloads.test.ts src/server/storage/PostgresStorageLifecycle.test.ts",
