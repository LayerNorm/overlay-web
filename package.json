    "test:p3c:unit": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/outputs/OutputService.test.ts src/server/outputs/GenerationUsagePolicy.test.ts src/server/app-api/v1/daytona/run/lifecycle.test.ts src/server/app-api/v1/daytona/run/sandbox-runner.test.ts",
