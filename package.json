    "check:on-prem-convex-boundaries": "tsx scripts/check-on-prem-convex-boundaries.ts",
    "test:on-prem:no-convex-server": "NODE_OPTIONS=--conditions=react-server tsx --test src/server/app-data/no-convex-runtime.test.ts",
