#!/usr/bin/env bash
#
# Lint changed files and typecheck affected complete projects before pushing.
#
# Catch lint errors and project-level type errors before remote CI starts.
# Typechecking keeps tsconfig context, generates current routes, and runs the
# existing boundary checks. Documentation-only pushes skip typechecking.
#
# Installed by `npm run hooks:install` (also run automatically by `npm install`),
# which points core.hooksPath at .githooks so the hook is shared and reviewed
# rather than living untracked in each clone's .git/hooks.
#
# Escape hatches, for when a push must go out regardless:
#   git push --no-verify
#   OVERLAY_SKIP_PRE_PUSH_LINT=1 git push
#   OVERLAY_SKIP_PRE_PUSH_TYPECHECK=1 git push
set -uo pipefail

if [ -n "${OVERLAY_SKIP_PRE_PUSH_LINT:-}" ]; then
  echo "pre-push: lint skipped via OVERLAY_SKIP_PRE_PUSH_LINT"
fi

zero="0000000000000000000000000000000000000000"
status=0

# Git feeds one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleting a remote branch pushes no content to lint.
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # New remote branch: there is no previous remote state to diff against, so
    # fall back to where this branch left the trunk.
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null)" \
      || base="$(git rev-parse "${local_sha}^" 2>/dev/null)" \
      || { echo "pre-push: could not resolve a base revision"; status=1; continue; }
  else
    base="$remote_sha"
  fi

  if [ -z "${OVERLAY_SKIP_PRE_PUSH_LINT:-}" ]; then
    node scripts/ci/lint-changed.mjs --range "${base}..${local_sha}" || status=1
  fi
  if [ -n "${OVERLAY_SKIP_PRE_PUSH_TYPECHECK:-}" ]; then
    echo "pre-push: typecheck skipped via OVERLAY_SKIP_PRE_PUSH_TYPECHECK"
  else
    node scripts/ci/typecheck-pre-push.mjs --range "${base}..${local_sha}" || status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo ""
  echo "pre-push: lint or project typecheck failed."
  echo "pre-push: fix the errors, or push with --no-verify if that is deliberate."
fi

exit "$status"
