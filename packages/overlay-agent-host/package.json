{
  "name": "@layernorm/overlay-agent-host",
  "version": "0.3.3",
  "description": "Outbound-only host for connecting user-owned and managed agents to Overlay.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LayerNorm/overlay-web.git",
    "directory": "packages/overlay-agent-host"
  },
  "homepage": "https://github.com/LayerNorm/overlay-web/tree/main/packages/overlay-agent-host#readme",
  "bugs": {
    "url": "https://github.com/LayerNorm/overlay-web/issues"
  },
  "type": "module",
  "bin": {
    "overlay-agent-host": "./src/cli.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/cli.mjs",
    "Dockerfile",
    "docker-compose.example.yml",
    "README.md",
    "systemd"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm --prefix ../overlay-agent-bridge-protocol run build && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "npm run build && tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@layernorm/overlay-agent-bridge-protocol": "0.3.3",
    "ai": "7.0.65",
    "eve": "0.44.4",
    "tsx": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5"
  }
}
