{
  "name": "@layernorm/overlay-agent-host",
  "version": "0.7.0",
  "description": "Outbound-only host that lets Overlay's own agents use this machine's tools, and runs private threads for Overlay Desktop.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LayerNorm/overlay.git",
    "directory": "packages/overlay-agent-host"
  },
  "homepage": "https://github.com/LayerNorm/overlay/tree/main/packages/overlay-agent-host#readme",
  "bugs": {
    "url": "https://github.com/LayerNorm/overlay/issues"
  },
  "type": "module",
  "bin": {
    "overlay-agent-host": "./src/cli.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/cli.mjs",
    "Dockerfile",
    "docker-compose.example.yml",
    "README.md",
    "systemd"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun run --cwd ../overlay-agent-bridge-protocol build && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun run build && tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.22",
    "@ai-sdk/google": "^4.0.33",
    "@ai-sdk/mcp": "2.0.45",
    "@ai-sdk/openai": "^4.0.21",
    "@layernorm/overlay-agent-bridge-protocol": "0.7.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "7.0.93",
    "tsx": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.10",
    "@types/node": "^24",
    "typescript": "^5"
  }
}
