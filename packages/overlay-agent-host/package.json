{
  "name": "@overlay/agent-host",
  "version": "0.0.1",
  "description": "Outbound-only host for connecting user-owned and managed agents to Overlay.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "overlay-agent-host": "./src/cli.mjs"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/*.ts",
    "src/*.mjs",
    "!src/*.test.ts",
    "Dockerfile",
    "docker-compose.example.yml",
    "README.md",
    "systemd"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@overlay/agent-bridge-protocol": "0.0.1",
    "eve": "0.44.4",
    "tsx": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5"
  }
}
