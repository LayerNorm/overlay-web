{
  "name": "@overlay/chat-react",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "sideEffects": [
    "./src/styles/chat-surface.css",
    "./src/styles/overlay-theme.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./draft-review-modal": "./src/components/DraftReviewModal.tsx",
    "./generated-ui-card": "./src/components/GeneratedUiCard.tsx",
    "./lazy-syntax-highlighter": "./src/components/LazySyntaxHighlighter.tsx",
    "./media-slot-output": "./src/components/MediaSlotOutput.tsx",
    "./model-indicators": "./src/components/ModelIndicators.tsx",
    "./model-qualities-panel": "./src/components/ModelQualitiesPanel.tsx",
    "./markdown-mentions": "./src/components/markdown/mentions.ts",
    "./sources-panel": "./src/components/SourcesPanel.tsx",
    "./user-message-bubble": "./src/components/UserMessageBubble.tsx",
    "./transcript": "./src/components/transcript/index.ts",
    "./transcript-scroll": "./src/components/transcript/TranscriptScroll.ts",
    "./exchange": "./src/components/exchange/index.ts",
    "./chat-surface.css": "./src/styles/chat-surface.css",
    "./styles.css": "./src/styles/overlay-theme.css"
  },
  "scripts": {
    "check:transcript-boundaries": "node scripts/check-transcript-boundaries.mjs",
    "typecheck": "npm run check:transcript-boundaries && tsc --noEmit",
    "test": "TSX_TSCONFIG_PATH=tsconfig.json node --import tsx --test src/**/*.test.tsx"
  },
  "dependencies": {
    "@overlay/chat-core": "file:../overlay-chat-core",
    "@overlay/modules-react": "file:../overlay-modules-react",
    "@overlay/ui": "file:../overlay-ui",
    "katex": "^0.16.11",
