# Self-hosted Convex backend environment.
#   cp convex.env.example convex.env && edit convex.env
# Then:
#   docker compose -f docker-compose.convex.yml --env-file convex.env up -d
#
# Everything marked REQUIRED must be set. Everything else has safe defaults.

# ---------------------------------------------------------------------------
# REQUIRED secrets — generate each once and store in your secrets manager.
# ---------------------------------------------------------------------------

# Postgres password for the bundled postgres service (or your managed DB).
POSTGRES_PASSWORD=

# S3 credentials for the bundled minio service (or your real S3 keys).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Root secret for the whole Convex deployment. `openssl rand -hex 32`.
# Rotating this invalidates all admin keys and sessions — treat like a root CA.
INSTANCE_SECRET=

# ---------------------------------------------------------------------------
# REQUIRED public origins — the hostnames the app and browsers actually reach.
# In AWS this is typically the ALB/DNS name, not localhost.
# ---------------------------------------------------------------------------

# Convex client API origin (maps to NEXT_PUBLIC_CONVEX_URL on the app).
CONVEX_CLOUD_ORIGIN=https://convex-api.enterprise.example.com
# Site proxy origin for HTTP actions.
CONVEX_SITE_ORIGIN=https://convex-site.enterprise.example.com

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Instance name — becomes the Postgres database name (dashes -> underscores).
INSTANCE_NAME=convex-self-hosted

# Image tags. Pin exact released tags in production.
CONVEX_BACKEND_IMAGE=ghcr.io/get-convex/convex-backend:latest
CONVEX_DASHBOARD_IMAGE=ghcr.io/get-convex/convex-dashboard:latest

# Ports.
CONVEX_API_PORT=3210
CONVEX_SITE_PORT=3211
DASHBOARD_PORT=6791
S3_CONSOLE_PORT=9001

# Bundled postgres identity (defaults: convex/convex).
POSTGRES_USER=convex
POSTGRES_DB=convex

# Keep "true" while POSTGRES_URL points at the bundled/internal postgres.
# Remove or set "false" when pointing at TLS-managed RDS/Aurora/Cloud SQL.
DO_NOT_REQUIRE_SSL=true

# S3 tuning — defaults match the bundled MinIO. For real S3 set
# S3_ENDPOINT_URL=https://s3.<region>.amazonaws.com, AWS_S3_FORCE_PATH_STYLE=false,
# AWS_S3_DISABLE_CHECKSUMS=false, and unset AWS_S3_DISABLE_SSE unless the store
# lacks KMS-backed server-side encryption.
S3_ENDPOINT_URL=http://objectstore:9000
S3_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_DISABLE_CHECKSUMS=true
AWS_S3_DISABLE_SSE=true

# Backend ops.
DISABLE_BEACON=true
DISABLE_METRICS_ENDPOINT=true
REDACT_LOGS_TO_CLIENT=true
RUST_LOG=info
# Document retention sweep delay in seconds (bounds `documents` table growth).
DOCUMENT_RETENTION_DELAY=172800

# Concurrency — scale with backend instance size.
APPLICATION_MAX_CONCURRENT_MUTATIONS=16
APPLICATION_MAX_CONCURRENT_QUERIES=16
APPLICATION_MAX_CONCURRENT_V8_ACTIONS=16
APPLICATION_MAX_CONCURRENT_NODE_ACTIONS=16

# ---------------------------------------------------------------------------
# Optional read mirror (docker-compose.mirror.yml)
# Replicates Convex data into normalized Postgres tables for BI / data lakes.
# ---------------------------------------------------------------------------

# Database the mirror writes to (created automatically on the bundled postgres
# via MIRROR_ADMIN_URL). For managed Postgres point MIRROR_DATABASE_URL at it
# in the compose overlay instead of relying on this name.
MIRROR_DB=mirror
# Postgres schema holding the mirror tables.
MIRROR_SCHEMA=mirror
# Delta poll interval in milliseconds.
MIRROR_POLL_MS=2000
# Optional comma-separated Convex table allowlist (empty = mirror everything).
MIRROR_TABLES=
# Admin key for the export API. After running bin/convex-bootstrap.sh the key
# lands in .env.convex.local as CONVEX_SELF_HOSTED_ADMIN_KEY — pass that file
# to compose with a second --env-file, or copy the key here:
#CONVEX_ADMIN_KEY=
