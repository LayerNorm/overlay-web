{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Overlay",
  "description": "Documentation for Overlay across web, desktop, and self-hosted deployments.",
  "colors": {
    "primary": "#0a0a0a",
    "light": "#f5f5f5",
    "dark": "#27272a"
  },
  "logo": {
    "light": "/assets/overlay-lockup-light.svg",
    "dark": "/assets/overlay-lockup-dark.svg",
    "href": "https://getoverlay.io"
  },
  "favicon": "/assets/overlay-mark.svg",
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#fafafa",
      "dark": "#09090b"
    }
  },
  "fonts": {
    "heading": {
      "family": "Libre Baskerville",
      "weight": 400
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://getoverlay.io/blog"
      },
      {
        "label": "Pricing",
        "href": "https://getoverlay.io/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://getoverlay.io/auth/sign-in"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "contextual": {
    "options": [
      "copy",
      "download-spec",
      "chatgpt",
      "claude"
    ]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": [
        "typescript",
        "javascript",
        "curl"
      ],
      "defaults": "required"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": [
          "introduction",
          "start/quickstart",
          "start/repository-map"
        ]
      },
      {
        "group": "Desktop",
        "pages": [
          "desktop/overview",
          {
            "group": "Get started",
            "pages": [
              "desktop/download-install",
              "desktop/system-requirements",
              "desktop/sign-in",
              "desktop/self-hosted-server",
              "desktop/build-from-source"
            ]
          },
          {
            "group": "Using the app",
            "pages": [
              "desktop/local-vs-cloud",
              "desktop/chat-permissions",
              "desktop/macos-permissions",
              "desktop/browser-security",
              "desktop/transcription"
            ]
          },
          {
            "group": "Maintenance and security",
            "pages": [
              "desktop/updates",
              "desktop/uninstall",
              "desktop/privacy-diagnostics",
              "desktop/security-reporting",
              "desktop/troubleshooting",
              "desktop/release-verification",
              "desktop/changelog"
            ]
          }
        ]
      },
      {
        "group": "Configure",
        "pages": [
          "configure/environment",
          "configure/runtime-config",
          "configure/providers",
          "configure/knowledge-bases",
          {
            "group": "Authentication",
            "pages": [
              "configure/authentication/index",
              {
                "group": "Backends",
                "pages": [
                  "configure/authentication/backends"
                ]
              },
              {
                "group": "Protocol",
                "pages": [
                  "configure/authentication/oidc"
                ]
              },
              {
                "group": "Provider recipes",
                "pages": [
                  "configure/authentication/recipes/google-workspace",
                  "configure/authentication/recipes/auth0",
                  "configure/authentication/recipes/generic-oidc"
                ]
              }
            ]
          }
        ]
      },
      {
        "group": "Develop",
        "pages": [
          "develop/architecture",
          {
            "group": "Workflow",
            "pages": [
              "develop/agentic-development",
              "develop/worktree-staging-qa",
              "develop/convex-workflow",
              "develop/local-integrations",
              "develop/customization",
              "develop/feature-modules"
            ]
          },
          {
            "group": "API",
            "pages": [
              "develop/api-source-of-truth",
              "develop/api-route-catalog",
              "develop/compact-api-route-catalog"
            ]
          }
        ]
      },
      {
        "group": "Deploy & Operate",
        "pages": [
          "deploy-operate/self-hosting",
          {
            "group": "Self-hosting",
            "pages": [
              "deploy-operate/one-command-install",
              "deploy-operate/self-hosted-convex",
              "deploy-operate/docker-ec2",
              "deploy-operate/aws",
              "deploy-operate/cloud-managed",
              "deploy-operate/enterprise-source-install"
            ]
          },
          {
            "group": "Enterprise",
            "pages": [
              "deploy-operate/enterprise-admin-onboarding",
              "deploy-operate/enterprise-security-launch-checklist",
              "deploy-operate/compliance",
              "deploy-operate/security",
              "deploy-operate/tenancy",
              "deploy-operate/executor-integrations",
              "deploy-operate/better-auth-onprem-runbook"
            ]
          },
          {
            "group": "Operations",
            "pages": [
              "deploy-operate/release-gates",
              "deploy-operate/docs-hosting"
            ]
          }
        ]
      },
      {
        "group": "API Reference",
        "pages": [
          "api-reference/overview",
          {
            "group": "Generated endpoints",
            "openapi": {
              "source": "openapi/overlay-web.openapi.json",
              "directory": "api-reference/endpoints"
            }
          },
          {
            "group": "Workflows",
            "pages": [
              "api-reference/workflows/bootstrap",
              "api-reference/workflows/conversations",
              "api-reference/workflows/files",
              "api-reference/workflows/memory-knowledge",
              "api-reference/workflows/automations",
              "api-reference/workflows/billing",
              "api-reference/workflows/admin"
            ]
          }
        ]
      },
      {
        "group": "Help",
        "pages": [
          "help/index",
          "help/chat",
          "help/memory",
          "help/files",
          "help/projects",
          "help/automations",
          "help/tools",
          "help/connect-other-apps",
          "help/other-agents",
          "help/agents",
          "help/settings",
          "help/faq"
        ]
      },
      {
        "group": "Legal",
        "pages": [
          "legal/licensing",
          "legal/self-hosting-obligations",
          "legal/security-reporting"
        ]
      },
      {
        "group": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ]
  }
}
