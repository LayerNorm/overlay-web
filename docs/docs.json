{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Overlay",
  "description": "Documentation for Overlay across web, desktop, and self-hosted deployments.",
  "colors": {
    "primary": "#111827"
  },
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "contextual": {
    "options": ["copy", "download-spec", "chatgpt", "claude"]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": ["typescript", "javascript", "curl"],
      "defaults": "required"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": ["introduction", "start/quickstart", "start/repository-map"]
      },
      {
        "group": "Desktop",
        "pages": [
          "desktop/overview",
          "desktop/download-install",
          "desktop/system-requirements",
          "desktop/sign-in",
          "desktop/self-hosted-server",
          "desktop/build-from-source",
          "desktop/local-vs-cloud",
          "desktop/chat-permissions",
          "desktop/macos-permissions",
          "desktop/browser-security",
          "desktop/transcription",
          "desktop/updates",
          "desktop/uninstall",
          "desktop/privacy-diagnostics",
          "desktop/security-reporting",
          "desktop/troubleshooting",
          "desktop/release-verification",
          "desktop/changelog"
        ]
      },
      {
        "group": "Configure",
        "pages": [
          "configure/environment",
          "configure/runtime-config",
          "configure/providers",
          "configure/knowledge-bases",
          {
            "group": "Authentication",
            "pages": [
              "configure/authentication/index",
              {
                "group": "Backends",
                "pages": ["configure/authentication/backends"]
              },
              {
                "group": "Protocol",
                "pages": ["configure/authentication/oidc"]
              },
              {
                "group": "Provider recipes",
                "pages": [
                  "configure/authentication/recipes/google-workspace",
                  "configure/authentication/recipes/auth0",
                  "configure/authentication/recipes/generic-oidc"
                ]
              }
            ]
          }
        ]
      },
      {
        "group": "Develop",
        "pages": ["develop/architecture", "develop/agentic-development", "develop/worktree-staging-qa", "develop/convex-workflow", "develop/local-integrations", "develop/customization", "develop/feature-modules", "develop/api-source-of-truth", "develop/api-route-catalog", "develop/compact-api-route-catalog"]
      },
      {
        "group": "Deploy & Operate",
        "pages": ["deploy-operate/self-hosting", "deploy-operate/docker-ec2", "deploy-operate/aws", "deploy-operate/cloud-managed", "deploy-operate/enterprise-source-install", "deploy-operate/one-command-install", "deploy-operate/better-auth-onprem-runbook", "deploy-operate/executor-integrations", "deploy-operate/enterprise-admin-onboarding", "deploy-operate/compliance", "deploy-operate/security", "deploy-operate/enterprise-security-launch-checklist", "deploy-operate/release-gates", "deploy-operate/tenancy", "deploy-operate/docs-hosting"]
      },
      {
        "group": "API Reference",
        "pages": [
          "api-reference/overview",
          {
            "group": "Generated endpoints",
            "openapi": {
              "source": "openapi/overlay-web.openapi.json",
              "directory": "api-reference/endpoints"
            }
          },
          {
            "group": "Workflows",
            "pages": [
              "api-reference/workflows/bootstrap",
              "api-reference/workflows/conversations",
              "api-reference/workflows/files",
              "api-reference/workflows/memory-knowledge",
              "api-reference/workflows/automations",
              "api-reference/workflows/billing",
              "api-reference/workflows/admin"
            ]
          }
        ]
      },
      {
        "group": "Legal",
        "pages": ["legal/licensing", "legal/self-hosting-obligations", "legal/security-reporting"]
      },
      {
        "group": "Changelog",
        "pages": ["changelog"]
      },
      {
        "group": "Help",
        "pages": ["help/index", "help/chat", "help/memory", "help/files", "help/projects", "help/automations", "help/settings", "help/faq"]
      }
    ]
  }
}
