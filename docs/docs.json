{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Overlay",
  "description": "Documentation for Overlay: using the web app, self-hosting, and building on the API.",
  "colors": {
    "primary": "#0a0a0a",
    "light": "#f5f5f5",
    "dark": "#27272a"
  },
  "logo": {
    "light": "/assets/overlay-lockup-light.svg",
    "dark": "/assets/overlay-lockup-dark.svg",
    "href": "https://getoverlay.io"
  },
  "favicon": "/assets/overlay-mark.svg",
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#fafafa",
      "dark": "#09090b"
    }
  },
  "fonts": {
    "heading": {
      "family": "Libre Baskerville",
      "weight": 400
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://getoverlay.io/blog"
      },
      {
        "label": "Pricing",
        "href": "https://getoverlay.io/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://getoverlay.io/auth/sign-in"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "contextual": {
    "options": [
      "copy",
      "download-spec",
      "chatgpt",
      "claude"
    ]
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": [
        "typescript",
        "javascript",
        "curl"
      ],
      "defaults": "required"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Help",
        "icon": "life-buoy",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "help/index",
              "help/faq"
            ]
          },
          {
            "group": "Using Overlay",
            "pages": [
              "help/chat",
              "help/agents",
              "help/other-agents",
              "help/automations",
              "help/files",
              "help/memory",
              "help/projects",
              "help/tools",
              "help/connect-other-apps",
              "help/settings"
            ]
          }
        ]
      },
      {
        "tab": "Self-hosting",
        "icon": "server",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "self-hosting/overview"
            ]
          },
          {
            "group": "Install",
            "pages": [
              "self-hosting/install/one-command",
              "self-hosting/install/docker",
              "self-hosting/install/aws",
              "self-hosting/install/self-hosted-convex",
              "self-hosting/install/from-source"
            ]
          },
          {
            "group": "Configure",
            "pages": [
              "self-hosting/configure/runtime-config",
              "self-hosting/configure/environment",
              "self-hosting/configure/providers",
              "self-hosting/configure/search-and-embeddings",
              {
                "group": "Authentication",
                "pages": [
                  "self-hosting/configure/authentication/index",
                  "self-hosting/configure/authentication/backends",
                  "self-hosting/configure/authentication/oidc",
                  {
                    "group": "Provider recipes",
                    "pages": [
                      "self-hosting/configure/authentication/recipes/google-workspace",
                      "self-hosting/configure/authentication/recipes/auth0",
                      "self-hosting/configure/authentication/recipes/generic-oidc"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "group": "Operate",
            "pages": [
              "self-hosting/operate/release-verification",
              "self-hosting/operate/security",
              "self-hosting/operate/security-checklist",
              "self-hosting/operate/better-auth-runbook",
              "self-hosting/operate/executor-integrations"
            ]
          },
          {
            "group": "Enterprise",
            "pages": [
              "self-hosting/enterprise/managed",
              "self-hosting/enterprise/tenancy",
              "self-hosting/enterprise/compliance",
              "self-hosting/enterprise/admin-onboarding"
            ]
          },
          {
            "group": "Licensing",
            "pages": [
              "self-hosting/licensing/license",
              "self-hosting/licensing/obligations"
            ]
          }
        ]
      },
      {
        "tab": "Developer",
        "icon": "code",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "developer/index"
            ]
          },
          {
            "group": "REST API",
            "pages": [
              "developer/api/overview",
              {
                "group": "Guides",
                "pages": [
                  "developer/api/guides/bootstrap",
                  "developer/api/guides/conversations",
                  "developer/api/guides/files",
                  "developer/api/guides/memory",
                  "developer/api/guides/automations",
                  "developer/api/guides/billing",
                  "developer/api/guides/admin"
                ]
              },
              {
                "group": "Reference",
                "openapi": {
                  "source": "openapi/overlay-web.openapi.json",
                  "directory": "developer/api/reference"
                }
              }
            ]
          },
          {
            "group": "Contribute",
            "pages": [
              "developer/contribute/run-locally",
              "developer/contribute/repository-map",
              "developer/contribute/architecture",
              "developer/contribute/local-integrations"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "developer/security"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "history",
        "groups": [
          {
            "group": "Changelog",
            "pages": [
              "changelog"
            ]
          }
        ]
      }
    ]
  },
