# Optional local overrides for `npm run better-auth:db:*` and `better-auth:migrate`.
# docker/docker-compose.better-auth.yml ships matching defaults, so this file is
# only needed when you want non-default ports or credentials.
BETTER_AUTH_POSTGRES_DB=overlay_auth
BETTER_AUTH_POSTGRES_USER=overlay_auth
BETTER_AUTH_POSTGRES_PASSWORD=overlay_auth_dev_password
BETTER_AUTH_POSTGRES_PORT=54329
BETTER_AUTH_DATABASE_URL=postgres://overlay_auth:overlay_auth_dev_password@localhost:54329/overlay_auth

# better-auth:migrate also resolves the full Overlay runtime config.
NODE_ENV=development
NEXT_PUBLIC_CONVEX_URL=https://fixture.convex.cloud
INTERNAL_API_SECRET=dev-internal-secret
INTERNAL_SERVICE_AUTH_SECRET=dev-service-secret
BETTER_AUTH_SECRET=dev-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_CONNECTION_ID=google-ws
BETTER_AUTH_CONNECTION_PRESET=google-workspace
BETTER_AUTH_CONNECTION_DOMAINS=example.com
BETTER_AUTH_CONNECTION_CLIENT_ID=dev-client-id
BETTER_AUTH_CONNECTION_CLIENT_SECRET=dev-client-secret
BETTER_AUTH_ALLOWED_EMAIL_DOMAINS=example.com
AUTH_PROVIDER=better-auth
