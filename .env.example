# Hosted provider credentials are unavailable unless this positive allow flag is
# exactly 1. Missing, false, or malformed values fail closed.
OVERLAY_HOSTED_PROVIDER_ACCESS_ENABLED=0
# Emergency override. Set to 1 to stop new owner-funded provider and integration
# operations immediately, even when access is explicitly enabled above.
OVERLAY_HOSTED_PROVIDER_KILL_SWITCH=1

# Official desktop downloads remain fail-closed until the signed/notarized
# release gate is approved. Set to 1 only for an approved Gate B release.
OVERLAY_DESKTOP_DOWNLOADS_ENABLED=0
