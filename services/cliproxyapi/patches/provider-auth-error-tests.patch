@@ -0,0 +1,44 @@
+package claude
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type authErrorRoundTripper func(*http.Request) (*http.Response, error)
+
+func (roundTrip authErrorRoundTripper) RoundTrip(request *http.Request) (*http.Response, error) {
+	return roundTrip(request)
+}
+
+func TestRefreshDecodesTypedHTTPErrorWithoutBodyDetails(t *testing.T) {
+	auth := &ClaudeAuth{httpClient: &http.Client{Transport: authErrorRoundTripper(func(request *http.Request) (*http.Response, error) {
+		return &http.Response{
+			StatusCode: http.StatusBadRequest,
+			Header:     make(http.Header),
+			Body:       io.NopCloser(strings.NewReader(`{"error":"invalid_grant","error_description":"private response detail"}`)),
+			Request:    request,
+		}, nil
+	})}}
+
+	_, err := auth.refreshTokensSingleFlight(context.Background(), "opaque-refresh-token")
+	var providerErr interface {
+		error
+		StatusCode() int
+		OAuthError() string
+	}
+	if !errors.As(err, &providerErr) {
+		t.Fatalf("refresh error type = %T", err)
+	}
+	if providerErr.StatusCode() != http.StatusBadRequest || providerErr.OAuthError() != "invalid_grant" {
+		t.Fatalf("typed refresh error = (%d, %q)", providerErr.StatusCode(), providerErr.OAuthError())
+	}
+	if strings.Contains(err.Error(), "private response detail") {
+		t.Fatal("refresh error exposed response details")
+	}
+}
