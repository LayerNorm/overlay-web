+package meta
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestDevicePollDecodesTypedOAuthErrorWithoutBodyDetails(t *testing.T) {
+	auth := &MetaAuth{httpClient: &http.Client{Transport: providerPollRoundTripper(func(request *http.Request) (*http.Response, error) {
+		return &http.Response{
+			StatusCode: http.StatusBadRequest,
+			Header:     make(http.Header),
+			Body:       io.NopCloser(strings.NewReader(`{"error":"access_denied","error_description":"private response detail"}`)),
+			Request:    request,
+		}, nil
+	})}}
+	device := &DeviceCodeResponse{DeviceCode: "opaque-device-code", TokenEndpoint: "https://auth.meta.com/token"}
+
+	_, _, _, err := auth.PollForAuthorizationOnce(context.Background(), device, 5*time.Second)
+	var providerErr interface {
+		error
+		StatusCode() int
+		OAuthError() string
+	}
+	if !errors.As(err, &providerErr) {
+		t.Fatalf("device poll error type = %T", err)
+	}
+	if providerErr.StatusCode() != http.StatusBadRequest || providerErr.OAuthError() != "access_denied" {
+		t.Fatalf("typed device error = (%d, %q)", providerErr.StatusCode(), providerErr.OAuthError())
+	}
+	if strings.Contains(err.Error(), "private response detail") {
+		t.Fatal("device poll error exposed response details")
+	}
+}
