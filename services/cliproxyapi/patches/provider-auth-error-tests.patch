@@ -0,0 +1,42 @@
+package xai
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestDevicePollDecodesTypedAuthorizationDenial(t *testing.T) {
+	auth := &XAIAuth{httpClient: &http.Client{Transport: providerPollRoundTripper(func(request *http.Request) (*http.Response, error) {
+		return &http.Response{
+			StatusCode: http.StatusBadRequest, Header: make(http.Header),
+			Body: io.NopCloser(strings.NewReader(`{"error":"access_denied","error_description":"private response detail"}`)), Request: request,
+		}, nil
+	})}}
+	token, err, _, pending := auth.PollDeviceCodeOnce(context.Background(), "https://auth.x.ai/oauth/token", "opaque-device-code", time.Second)
+	if token != nil || pending {
+		t.Fatalf("device poll result = (%v, %v)", token, pending)
+	}
+	var providerErr interface {
+		error
+		StatusCode() int
+		OAuthError() string
+	}
+	if !errors.As(err, &providerErr) || providerErr.StatusCode() != http.StatusBadRequest || providerErr.OAuthError() != "access_denied" {
+		t.Fatalf("device poll error = %T (%v)", err, err)
+	}
+	if strings.Contains(err.Error(), "private response detail") {
+		t.Fatal("device poll error exposed response details")
+	}
+}
