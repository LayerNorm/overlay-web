+package xai
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+type providerPollRoundTripper func(*http.Request) (*http.Response, error)
+
+func (roundTrip providerPollRoundTripper) RoundTrip(request *http.Request) (*http.Response, error) {
+	return roundTrip(request)
+}
+
+func TestPollDeviceCodeOncePreservesSlowdownInterval(t *testing.T) {
+	client := &http.Client{Transport: providerPollRoundTripper(func(request *http.Request) (*http.Response, error) {
+		return &http.Response{
+			StatusCode: http.StatusBadRequest, Header: make(http.Header),
+			Body: io.NopCloser(strings.NewReader(`{"error":"slow_down"}`)), Request: request,
+		}, nil
+	})}
+	auth := &XAIAuth{httpClient: client}
+
+	token, err, interval, pending := auth.PollDeviceCodeOnce(
+		context.Background(), "https://auth.x.ai/oauth/token", "opaque-device-code", 5*time.Second,
+	)
+	if err != nil || token != nil || !pending || interval != 10*time.Second {
+		t.Fatalf("poll result = (%v, %v, %v, %v)", token, err, interval, pending)
+	}
+}
