+
+type providerPollRoundTripper func(*http.Request) (*http.Response, error)
+
+func (roundTrip providerPollRoundTripper) RoundTrip(request *http.Request) (*http.Response, error) {
+	return roundTrip(request)
+}
+
+func TestPollForAuthorizationOncePreservesSlowdownInterval(t *testing.T) {
+	auth := &MetaAuth{httpClient: &http.Client{Transport: providerPollRoundTripper(func(request *http.Request) (*http.Response, error) {
+		return &http.Response{
+			StatusCode: http.StatusBadRequest, Header: make(http.Header),
+			Body: io.NopCloser(strings.NewReader(`{"error":"slow_down"}`)), Request: request,
+		}, nil
+	})}}
+
+	bundle, pending, interval, err := auth.PollForAuthorizationOnce(
+		context.Background(),
+		&DeviceCodeResponse{DeviceCode: "opaque-device-code", TokenEndpoint: "https://auth.meta.com/oidc/device/token/"},
+		5*time.Second,
+	)
+	if err != nil || bundle != nil || !pending || interval != 10*time.Second {
+		t.Fatalf("poll result = (%v, %v, %v, %v)", bundle, pending, interval, err)
+	}
+}
