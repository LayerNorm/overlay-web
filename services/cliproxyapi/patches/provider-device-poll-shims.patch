+// PollForAuthorizationOnce performs one token poll and reuses Meta's API-key minting flow.
+func (a *MetaAuth) PollForAuthorizationOnce(ctx context.Context, dcr *DeviceCodeResponse, interval time.Duration) (*MetaAuthBundle, bool, time.Duration, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if dcr == nil || strings.TrimSpace(dcr.DeviceCode) == "" {
+		return nil, false, interval, fmt.Errorf("meta auth: missing device code response")
+	}
+	tokenEndpoint := strings.TrimSpace(dcr.TokenEndpoint)
+	if tokenEndpoint == "" {
+		tokenEndpoint = TokenEndpoint
+	}
+	if interval <= 0 {
+		interval = DefaultPollInterval
+	}
+	form := url.Values{
+		"grant_type":  {DeviceCodeGrantType},
+		"device_code": {dcr.DeviceCode},
+		"client_id":   {ClientID},
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, tokenEndpoint, strings.NewReader(form.Encode()))
+	if err != nil {
+		return nil, false, interval, fmt.Errorf("meta auth: create token request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("User-Agent", "muse-code/1.0.2")
+	resp, err := a.httpClient.Do(req)
+	if err != nil {
+		return nil, false, interval, err
+	}
+	defer func() { _ = resp.Body.Close() }()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, false, interval, err
+	}
+	doc := ojson.ParseBytes(body)
+	if !doc.IsObject() {
+		return nil, false, interval, fmt.Errorf("meta auth: invalid token response")
+	}
+	if resp.StatusCode == http.StatusOK {
+		tokenData := &TokenData{
+			AccessToken: doc.Get("access_token").String(),
+			TokenType:   doc.Get("token_type").String(),
+			ExpiresIn:   int(doc.Get("expires_in").Int()),
+		}
+		if tokenData.AccessToken == "" {
+			return nil, false, interval, fmt.Errorf("meta auth: response missing access_token")
+		}
+		if tokenData.ExpiresIn > 0 {
+			tokenData.ExpiresAt = time.Now().Add(time.Duration(tokenData.ExpiresIn) * time.Second).Unix()
+		}
+		bundle := &MetaAuthBundle{TokenData: tokenData}
+		minted, errMint := a.MintAPIKey(ctx, tokenData.AccessToken)
+		if errMint != nil {
+			log.Warnf("meta auth: could not mint api_key from dca_token")
+		} else if minted != nil {
+			bundle.MintedKey = minted
+			bundle.Email = minted.UserEmail
+			bundle.Name = minted.UserFullName
+		}
+		return bundle, false, interval, nil
+	}
+	switch doc.Get("error").String() {
+	case "authorization_pending":
+		return nil, true, interval, nil
+	case "slow_down":
+		return nil, true, interval + 5*time.Second, nil
+	case "access_denied":
+		return nil, false, interval, fmt.Errorf("meta auth: access was denied by user")
+	case "expired_token":
+		return nil, false, interval, fmt.Errorf("meta auth: device code has expired")
+	default:
+		if value := strings.TrimSpace(doc.Get("error").String()); value != "" {
+			return nil, false, interval, fmt.Errorf("meta auth: authorization request failed")
+		}
+		return nil, false, interval, fmt.Errorf("meta auth: unexpected token response")
+	}
+}
