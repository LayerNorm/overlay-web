+// PollDeviceCodeOnce performs one device token exchange and returns the next interval.
+func (c *DeviceFlowClient) PollDeviceCodeOnce(ctx context.Context, deviceCode string, interval time.Duration) (*KimiTokenData, bool, time.Duration, error) {
+	if c == nil || strings.TrimSpace(deviceCode) == "" {
+		return nil, false, interval, fmt.Errorf("kimi: device code is required")
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if interval < defaultPollInterval {
+		interval = defaultPollInterval
+	}
+	token, err, pending := c.exchangeDeviceCode(ctx, deviceCode)
+	nextInterval := interval
+	if c.lastPollSlowDown {
+		nextInterval += 5 * time.Second
+		c.lastPollSlowDown = false
+	}
+	return token, pending, nextInterval, err
+}
