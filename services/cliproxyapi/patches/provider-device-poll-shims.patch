+// PollDeviceCodeOnce performs one device token exchange and returns the next interval.
+func (a *XAIAuth) PollDeviceCodeOnce(ctx context.Context, tokenEndpoint, deviceCode string, interval time.Duration) (*TokenData, error, time.Duration, bool) {
+	if a == nil {
+		return nil, fmt.Errorf("xai device flow: auth service is nil"), interval, false
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	endpoint, err := ValidateOAuthEndpoint(tokenEndpoint, "token_endpoint")
+	if err != nil {
+		return nil, err, interval, false
+	}
+	return a.exchangeDeviceCode(ctx, endpoint, deviceCode, interval)
