+func StartCodexDeviceAuthorization(ctx context.Context, cfg *config.Config) (*CodexDeviceAuthorization, error) {
+	if cfg == nil {
+		return nil, fmt.Errorf("codex device flow requires configuration")
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	client := util.SetProxy(&cfg.SDKConfig, &http.Client{})
+	userCodeResp, err := requestCodexDeviceUserCode(ctx, client)
+	if err != nil {
+		return nil, err
+	}
+	deviceAuthID := strings.TrimSpace(userCodeResp.DeviceAuthID)
+	userCode := strings.TrimSpace(userCodeResp.UserCode)
+	if userCode == "" {
+		userCode = strings.TrimSpace(userCodeResp.UserCodeAlt)
+	}
+	if deviceAuthID == "" || userCode == "" {
+		return nil, fmt.Errorf("codex device flow did not return required fields")
+	}
+	return &CodexDeviceAuthorization{
+		DeviceAuthID: deviceAuthID,
+		UserCode:     userCode,
+		Interval:     parseCodexDevicePollInterval(userCodeResp.Interval),
+		ExpiresAt:    time.Now().Add(codexDeviceTimeout),
+	}, nil
+}
+
+func PollCodexDeviceAuthorization(ctx context.Context, cfg *config.Config, deviceAuthID, userCode string) (*coreauth.Auth, bool, error) {
+	if cfg == nil {
+		return nil, false, fmt.Errorf("codex device flow requires configuration")
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	client := util.SetProxy(&cfg.SDKConfig, &http.Client{})
+	tokenResp, pending, err := pollCodexDeviceTokenOnce(ctx, client, deviceAuthID, userCode)
+	if err != nil || pending {
+		return nil, pending, err
+	}
+	authCode := strings.TrimSpace(tokenResp.AuthorizationCode)
+	codeVerifier := strings.TrimSpace(tokenResp.CodeVerifier)
+	codeChallenge := strings.TrimSpace(tokenResp.CodeChallenge)
+	if authCode == "" || codeVerifier == "" || codeChallenge == "" {
+		return nil, false, fmt.Errorf("codex device flow token response missing required fields")
+	}
+	authSvc := codex.NewCodexAuth(cfg)
+	authBundle, err := authSvc.ExchangeCodeForTokensWithRedirect(
+		ctx,
+		authCode,
+		codexDeviceTokenExchangeRedirectURI,
+		&codex.PKCECodes{CodeVerifier: codeVerifier, CodeChallenge: codeChallenge},
+	)
+	if err != nil {
+		return nil, false, err
+	}
+	record, err := NewCodexAuthenticator().buildAuthRecord(authSvc, authBundle)
+	if err != nil {
+		return nil, false, err
+	}
+	return record, false, nil
+}
+
