OVERLAY_PROVIDER_DATABASE=postgres
OVERLAY_DATABASE_URL=postgres://overlay_app:overlay_app_dev_password@localhost:54330/overlay_app
OVERLAY_DATABASE_SSL_MODE=disable
OVERLAY_PROVIDER_RATE_LIMIT=redis
OVERLAY_REDIS_URL=redis://localhost:56379
OVERLAY_REDIS_FAILURE_MODE=deny
OVERLAY_WORKER_LEASE_MS=60000
OVERLAY_WORKER_POLL_MS=1000
OVERLAY_SCHEDULER_POLL_MS=5000
OVERLAY_WORKER_DB_POOL_SIZE=5
BILLING_PROVIDER=none
BILLING_ENABLED=false
OVERLAY_CAPABILITY_BILLING=false
OVERLAY_FEATURE_BILLING=false
OVERLAY_PROVIDER_VECTOR_SEARCH=none
VECTOR_SEARCH_ENABLED=false
OVERLAY_FEATURE_VECTOR_SEARCH=false

OVERLAY_POSTGRES_DB=overlay_app
OVERLAY_POSTGRES_USER=overlay_app
OVERLAY_POSTGRES_PASSWORD=overlay_app_dev_password
OVERLAY_POSTGRES_PORT=54330
OVERLAY_REDIS_PORT=56379
