{
  "expo": {
    "name": "Overlay",
    "slug": "overlay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "overlay",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.layernorm.overlay-mobile",
      "infoPlist": {},
      "associatedDomains": [
        "applinks:www.getoverlay.io",
        "applinks:www.getoverlay.io?mode=developer"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.getoverlay.io",
              "pathPrefix": "/auth/native/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "backgroundColor": "#00000000",
          "borderColor": "#00000000",
          "barStyle": "dark",
          "visibility": "visible"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "position": "absolute",
        "backgroundColor": "#00000000",
        "borderColor": "#00000000",
        "barStyle": "dark",
        "visibility": "visible"
      },
      "eas": {
        "projectId": "268cf4d6-4a66-43bc-88cd-8b308a53c2ff"
      }
    },
    "owner": "layernorm-inc"
  }
}
