{
  "expo": {
    "name": "Overlay",
    "slug": "overlay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/268cf4d6-4a66-43bc-88cd-8b308a53c2ff"
    },
    "scheme": "overlay",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.layernorm.overlay-mobile",
      "buildNumber": "1.0.0.1",
      "associatedDomains": [
        "applinks:www.getoverlay.io"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.layernorm.overlay_mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.getoverlay.io",
              "pathPrefix": "/auth/native/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.getoverlay.io",
              "pathPrefix": "/share/"
            },
            {
              "scheme": "https",
              "host": "www.getoverlay.io",
              "pathPrefix": "/invitations/"
            },
            {
              "scheme": "https",
              "host": "www.getoverlay.io",
              "pathPrefix": "/app/invitations/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "react-native-enriched-markdown",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#0a0a0a",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "268cf4d6-4a66-43bc-88cd-8b308a53c2ff"
      }
    },
    "owner": "layernorm-inc"
  }
}
