{
  "name": "overlay-mobile",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-pre-install": "node scripts/prepare-eas-workspace.cjs",
    "eas-build-post-install": "node scripts/prepare-eas-workspace.cjs --build && bun run build:shared-markdown-css",
    "build:shared-markdown-css": "node scripts/build-shared-markdown-css.cjs",
    "verify:shared-markdown-assets": "node scripts/verify-shared-markdown-assets.cjs",
    "export:android:shared-markdown": "node scripts/export-shared-markdown-android.cjs",
    "test:shared-markdown": "node --test scripts/sharedMarkdownProof.test.cjs",
    "test:native-transcript": "node --test scripts/native-chat-transcript-actions.test.cjs scripts/shared-transcript-proof-mode.test.cjs scripts/native-personal-chat-transcript-host.test.cjs scripts/native-chat-screen-integration.test.cjs && TSX_TSCONFIG_PATH=../../tsconfig.json NODE_OPTIONS='--require=./scripts/register-shared-markdown-style-noop.cjs --require=./scripts/register-native-transcript-test-runtime.cjs' node --import tsx --test scripts/native-chat-transcript-dom.test.tsx",
    "start": "expo start",
    "start:device": "expo start --dev-client --host tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "bun run check:no-legacy-app-api && bun run check:no-direct-backend && bun run check:no-secret-env && bun run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "check:no-legacy-app-api": "node ./scripts/ensure-no-legacy-app-api.cjs",
    "check:no-direct-backend": "node ./scripts/ensure-no-direct-backend.cjs",
    "check:no-secret-env": "node ./scripts/ensure-no-secret-env.cjs"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.0.1",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo/metro-runtime": "~55.0.10",
    "@expo/ui": "~55.0.12",
    "@expo/vector-icons": "^15.0.3",
    "@overlay/api-client": "workspace:*",
    "@overlay/app-core": "workspace:*",
    "@overlay/chat-core": "workspace:*",
    "@overlay/workspace-contracts": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/elements": "2.9.15",
    "@react-navigation/native": "7.2.2",
    "@react-navigation/native-stack": "7.14.12",
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "convex": "^1.41.0",
    "expo": "~55.0.17",
    "expo-auth-session": "~55.0.15",
    "expo-blur": "~55.0.14",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.14",
    "expo-dev-client": "~55.0.28",
    "expo-device": "~55.0.21",
    "expo-document-picker": "~55.0.13",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-glass-effect": "~55.0.10",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.19",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-navigation-bar": "~55.0.12",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-sharing": "~55.0.24",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.14",
    "lucide-react-native": "^1.71.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-enriched-markdown": "^0.5.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/plugin-transform-flow-strip-types": "7.27.1",
    "@babel/plugin-transform-modules-commonjs": "7.28.6",
    "@babel/plugin-transform-react-jsx": "7.28.6",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~55.0.21",
    "esbuild": "0.27.0",
    "playwright": "1.61.1",
    "sf-symbols-typescript": "2.2.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.2"
  },
  "private": true
}
