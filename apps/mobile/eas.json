{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_NO_BUNDLE_SPLITTING": "1"
      },
      "ios": {
        "simulator": false
      },
      "bun": "1.4.5"
    },
    "preview": {
      "environment": "preview",
      "autoIncrement": true,
      "distribution": "internal",
      "env": {
        "EXPO_NO_BUNDLE_SPLITTING": "1"
      },
      "ios": {
        "enterpriseProvisioning": "adhoc"
      },
      "bun": "1.4.5"
    },
    "simulator-smoke": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "node": "22.13.0",
      "env": {
        "EXPO_NO_BUNDLE_SPLITTING": "1"
      },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2",
        "resourceClass": "m-medium"
      },
      "bun": "1.4.5"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6765998182"
      }
    }
  }
}
