{
  "manifest_version": 3,
  "name": "Overlay",
  "description": "Overlay in Chrome's side panel: your agents, chats and files next to the page you're on.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["sidePanel", "scripting"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Overlay",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
