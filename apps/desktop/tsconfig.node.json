{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/types/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node"
    ],
    "baseUrl": ".",
    // The shared bridge package lives in the monorepo's packages/ folder; its zod resolves from this app.
    "paths": { "zod": ["./node_modules/zod"] }
  }
}
