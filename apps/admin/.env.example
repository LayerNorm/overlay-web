# ── Overlay admin app (apps/admin) environment ──────────────────────────────
# Plain language: this app is the operator console. It signs operators in with
# the same WorkOS environment as the web app, keeps its own session cookie,
# and calls the Convex admin functions with its own server secret.

# Convex deployment the console talks to. Production value:
#   NEXT_PUBLIC_CONVEX_URL=https://<prod>.convex.cloud
# Local dev: point at your engineer dev backend instead.
NEXT_PUBLIC_CONVEX_URL=
# Optional dev override (same convention as the web app): used when
# NODE_ENV=development so you don't have to overwrite the prod value.
DEV_NEXT_PUBLIC_CONVEX_URL=

# Secret the admin functions (`admin/*ByServer`) verify. Local dev: your dev
# backend's INTERNAL_API_SECRET value (set it on the dev Convex deployment and
# repeat it here). Stage 3 deployments use the dedicated ADMIN_API_SECRET
# instead — both names are accepted.
ADMIN_CONVEX_SECRET=

# HMAC key signing the __Host-overlay_admin_session cookie (8h absolute +
# 30m idle). Generate once: `openssl rand -base64 32`. Separate from the web
# app's SESSION_SECRET on purpose.
ADMIN_SESSION_SECRET=

# WorkOS credentials — same environment/client as the web app. The WorkOS
# dashboard needs <admin-origin>/auth/callback added as a redirect URI.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Comma-separated WorkOS user ids allowed past the sign-in gate.
ADMIN_ALLOWED_USER_IDS=user_01H...,user_02H...
