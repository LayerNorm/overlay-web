# Docker/EC2 sanity-check profile. Copy this file to deploy/ec2/.env, set file
# mode 0600, and replace every replace_me value. Never commit deploy/ec2/.env.

OVERLAY_WEB_IMAGE=overlay-web:ec2-sanity
OVERLAY_HTTP_PORT=3000
OVERLAY_ENV_FILE=.env
OVERLAY_CONFIG_PATH=./overlay.config.json

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=http://localhost:3000
OVERLAY_DEPLOYMENT_ENV=onprem

OVERLAY_CONFIG_VERSION=2
OVERLAY_CONFIG_PRESET=onprem-minimal
OVERLAY_COMPLIANCE_PROFILE=onprem-minimal
OVERLAY_ALLOW_EXTERNAL_PROCESSORS=true

# Use two separate databases. Passwords must be URL-encoded.
OVERLAY_PROVIDER_DATABASE=postgres
OVERLAY_DATABASE_URL=postgresql://overlay_app:replace_me@replace-me.rds.amazonaws.com:5432/overlay_app?sslmode=verify-full
OVERLAY_DATABASE_SSL_MODE=verify-full
BETTER_AUTH_DATABASE_URL=postgresql://overlay_auth:replace_me@replace-me.rds.amazonaws.com:5432/overlay_auth?sslmode=verify-full
OVERLAY_BACKGROUND_RUNTIME_ENABLED=true

# Use the TLS ElastiCache endpoint. The EC2 and Redis security groups must allow
# this connection. The application fails closed while Redis is unavailable.
OVERLAY_PROVIDER_RATE_LIMIT=redis
OVERLAY_REDIS_URL=rediss://replace-me.cache.amazonaws.com:6379
OVERLAY_REDIS_KEY_PREFIX=overlay:sanity:
OVERLAY_REDIS_FAILURE_MODE=deny

# Generate every application secret independently with: openssl rand -hex 32
INTERNAL_API_SECRET=replace_me_with_64_hex_characters
INTERNAL_SERVICE_AUTH_SECRET=replace_me_with_different_64_hex_characters
SESSION_SECRET=replace_me_with_different_64_hex_characters
SESSION_TRANSFER_KEY=replace_me_with_different_64_hex_characters
SESSION_COOKIE_ENCRYPTION_KEY=replace_me_with_different_64_hex_characters
MCP_CREDENTIAL_ENCRYPTION_KEY=replace_me_with_different_64_hex_characters
API_KEY_HASH_SECRET=replace_me_with_different_64_hex_characters
PROVIDER_KEYS_SECRET=replace_me_with_different_64_hex_characters
HOOKS_TOKEN_SALT=replace_me_with_different_64_hex_characters

# Better Auth owns the web session. Google Workspace is the primary EC2 sanity
# flow. See docs/configure/authentication/recipes/google-workspace.mdx.
AUTH_PROVIDER=better-auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_BASE_PATH=/api/better-auth
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_SECRET=replace_me_with_different_64_hex_characters
BETTER_AUTH_CONNECTION_ID=workspace
BETTER_AUTH_CONNECTION_PRESET=google-workspace
BETTER_AUTH_CONNECTION_LABEL=Continue with Google
BETTER_AUTH_CONNECTION_DOMAINS=example.edu
BETTER_AUTH_CONNECTION_CLIENT_ID=replace_me
BETTER_AUTH_CONNECTION_CLIENT_SECRET=replace_me
BETTER_AUTH_REQUIRE_VERIFIED_EMAIL=true
BETTER_AUTH_ALLOWED_EMAIL_DOMAINS=example.edu
BETTER_AUTH_JWT_ISSUER=http://localhost:3000
BETTER_AUTH_JWT_AUDIENCE=http://localhost:3000
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/better-auth/jwks

# The sanity profile enables chat through AI Gateway but keeps files, vector
# search, memory, knowledge, automations, integrations, and telemetry disabled.
OVERLAY_PROVIDER_MODELS=ai-gateway
LLM_GATEWAY=ai-gateway
AI_GATEWAY_API_KEY=replace_me
DEFAULT_CHAT_MODEL_ID=openai/gpt-4.1-mini
OVERLAY_PROVIDER_OBJECT_STORAGE=none
OVERLAY_PROVIDER_VECTOR_SEARCH=none
OVERLAY_PROVIDER_EMBEDDINGS=none
VECTOR_SEARCH_ENABLED=false
OVERLAY_FEATURE_VECTOR_SEARCH=false
OVERLAY_FEATURE_FILES=false
OVERLAY_FEATURE_MEMORY=false
OVERLAY_FEATURE_KNOWLEDGE=false
OVERLAY_FEATURE_AUTOMATIONS=false
OVERLAY_FEATURE_INTEGRATIONS=false
OVERLAY_FEATURE_WEBHOOKS=false
OVERLAY_FEATURE_BROWSER_USE=false
OVERLAY_FEATURE_SANDBOXES=false
OVERLAY_FEATURE_WEB_SEARCH=false
OVERLAY_FEATURE_ANALYTICS=false
OVERLAY_FEATURE_ERROR_REPORTING=false
NEXT_PUBLIC_OVERLAY_FEATURE_ANALYTICS=false
NEXT_PUBLIC_OVERLAY_FEATURE_ERROR_REPORTING=false
OVERLAY_PROVIDER_INTEGRATIONS=none
OVERLAY_PROVIDER_BROWSER=none
OVERLAY_PROVIDER_SANDBOX=none
OVERLAY_PROVIDER_WEB_SEARCH=none
OVERLAY_PROVIDER_ANALYTICS=none
OVERLAY_PROVIDER_ERROR_REPORTING=none
BILLING_PROVIDER=none
OVERLAY_FEATURE_BILLING=false
