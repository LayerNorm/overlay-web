# Copy to .env.onprem and replace every placeholder before running:
#   cp .env.onprem.example .env.onprem
#   cp docs/config/enterprise-private.example.json overlay.config.json
#   docker compose -f docker-compose.onprem.yml pull
#   docker compose -f docker-compose.onprem.yml up -d
#
# This compatibility path pulls a published image. For the source-first enterprise
# path, use .env.enterprise.example with the root docker-compose.yml.

OVERLAY_WEB_IMAGE=ghcr.io/layernorm/overlay-web:latest
OVERLAY_HTTP_PORT=3000

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Public app and Convex endpoints.
NEXT_PUBLIC_APP_URL=https://overlay.enterprise.example.com
NEXT_PUBLIC_CONVEX_URL=https://convex-enterprise.example.com

# Runtime config mounted by docker-compose.onprem.yml.
OVERLAY_CONFIG_FILE=/app/overlay.config.json
OVERLAY_CONFIG_VERSION=2
OVERLAY_CONFIG_PRESET=enterprise-private

# App-only secrets. Do not put these in Convex except INTERNAL_API_SECRET.
INTERNAL_API_SECRET=replace_with_internal_api_secret
INTERNAL_SERVICE_AUTH_SECRET=replace_with_internal_service_auth_secret
SESSION_SECRET=replace_with_session_secret
SESSION_TRANSFER_KEY=replace_with_session_transfer_key
SESSION_COOKIE_ENCRYPTION_KEY=replace_with_cookie_encryption_key

# OIDC. Keycloak realms can be configured here with their realm issuer URL.
AUTH_PROVIDER=oidc
OIDC_ISSUER_URL=https://idp.enterprise.example.com
OIDC_CLIENT_ID=overlay-web
OIDC_CLIENT_SECRET=replace_with_oidc_client_secret
OIDC_AUDIENCE=overlay-api

# Better Auth alternative. Uncomment this block instead of the OIDC block when
# Overlay should own the web session and issue Convex-verifiable service JWTs.
# AUTH_PROVIDER=better-auth
# BETTER_AUTH_URL=https://overlay.enterprise.example.com
# BETTER_AUTH_BASE_PATH=/api/better-auth
# BETTER_AUTH_SECRET=replace_with_better_auth_secret
# BETTER_AUTH_DATABASE_URL=postgres://overlay_auth:replace_with_password@postgres:5432/overlay_auth
# BETTER_AUTH_CONNECTION_ID=primary-sso
# BETTER_AUTH_CONNECTION_PRESET=generic-oidc
# BETTER_AUTH_CONNECTION_LABEL=Continue with Enterprise SSO
# BETTER_AUTH_CONNECTION_DOMAINS=enterprise.example.com
# BETTER_AUTH_CONNECTION_ISSUER_URL=https://idp.enterprise.example.com
# BETTER_AUTH_CONNECTION_CLIENT_ID=overlay-web
# BETTER_AUTH_CONNECTION_CLIENT_SECRET=replace_with_oidc_client_secret
# BETTER_AUTH_REQUIRE_VERIFIED_EMAIL=true
# BETTER_AUTH_ALLOWED_EMAIL_DOMAINS=enterprise.example.com
# BETTER_AUTH_JWT_ISSUER=https://overlay.enterprise.example.com
# BETTER_AUTH_JWT_AUDIENCE=https://overlay.enterprise.example.com
# BETTER_AUTH_JWKS_URL=https://overlay.enterprise.example.com/api/better-auth/jwks

# Postgres app-data setup. This is separate from BETTER_AUTH_DATABASE_URL.
# Postgres app-data supports pgvector when migrations and a durable worker are enabled.
# OVERLAY_PROVIDER_DATABASE=postgres
# OVERLAY_DATABASE_URL=postgres://overlay_app:replace_with_password@postgres:5432/overlay_app
# OVERLAY_DATABASE_SSL_MODE=require
# Distributed runtime coordination. Use the ElastiCache/Redis primary endpoint in AWS.
# OVERLAY_PROVIDER_RATE_LIMIT=redis
# OVERLAY_REDIS_URL=rediss://overlay-redis.internal:6379
# OVERLAY_REDIS_FAILURE_MODE=deny
# Run `npm run app-db:worker` as a separately supervised service.
# OVERLAY_WORKER_LEASE_MS=60000
# OVERLAY_WORKER_POLL_MS=1000
# OVERLAY_SCHEDULER_POLL_MS=5000
# OVERLAY_WORKER_DB_POOL_SIZE=5
OVERLAY_PROVIDER_VECTOR_SEARCH=none
VECTOR_SEARCH_ENABLED=false
OVERLAY_FEATURE_VECTOR_SEARCH=false
# To enable knowledge retrieval, use pgvector plus one supported embeddings provider:
# OVERLAY_PROVIDER_VECTOR_SEARCH=pgvector
# OVERLAY_PROVIDER_EMBEDDINGS=openai
# OVERLAY_EMBEDDING_MODEL_VERSION=text-embedding-3-small-v1
# VECTOR_SEARCH_ENABLED=true
# OVERLAY_FEATURE_VECTOR_SEARCH=true

# Billing disabled for private deployments by default.
BILLING_PROVIDER=none
OVERLAY_FEATURE_BILLING=false

# S3-compatible object storage. The bucket must already exist.
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=overlay-enterprise
S3_REGION=us-east-1
S3_ENDPOINT_URL=https://s3.enterprise.example.com
S3_ACCESS_KEY_ID=replace_with_s3_access_key
S3_SECRET_ACCESS_KEY=replace_with_s3_secret_key
S3_FORCE_PATH_STYLE=false

# Direct model provider example. Set LLM_GATEWAY=none to ship without external models.
LLM_GATEWAY=openai
OPENAI_API_KEY=replace_with_openai_api_key
DEFAULT_CHAT_MODEL_ID=gpt-4.1

# Disable high-risk external processors until explicitly approved.
OVERLAY_FEATURE_INTEGRATIONS=false
OVERLAY_FEATURE_BROWSER_USE=false
OVERLAY_FEATURE_SANDBOXES=false
OVERLAY_FEATURE_WEB_SEARCH=false
OVERLAY_FEATURE_ANALYTICS=false
OVERLAY_FEATURE_ERROR_REPORTING=false
NEXT_PUBLIC_OVERLAY_FEATURE_ANALYTICS=false
NEXT_PUBLIC_OVERLAY_FEATURE_ERROR_REPORTING=false
OVERLAY_PROVIDER_INTEGRATIONS=none
OVERLAY_PROVIDER_BROWSER=none
OVERLAY_PROVIDER_SANDBOX=none
OVERLAY_PROVIDER_WEB_SEARCH=none
OVERLAY_PROVIDER_ANALYTICS=none
OVERLAY_PROVIDER_ERROR_REPORTING=none

# Optional enterprise compliance metadata.
OVERLAY_COMPLIANCE_PROFILE=enterprise-private
OVERLAY_ALLOW_EXTERNAL_PROCESSORS=false
OVERLAY_ALLOWED_PROCESSORS=models:openai,objectStorage:s3
