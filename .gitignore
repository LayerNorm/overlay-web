# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/
/.auth/

# next.js
/.next/
/.next-analyze/
/.next.stale.*/
/out/

# production
/build
packages/*/dist/
packages/*/node_modules/
workers/*/node_modules/
workers/*/.wrangler/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.onprem.example
!.env.enterprise.example
!.env.app-data.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

archives/*
.env*.local
.cursor/hooks/state/*.json
.gstack/
transcripts/
plans/*

# private security notes and launch-blocker findings
/docs/security/
/internal-docs/security/

src/remotion/*
renders/*
.env.local

.cursor/*
.claude/*
.windsurf/*
.devin/*
.deepsec/*

# surface folders

# codealmanac
.almanac/index.db
.almanac/index.db-wal
.almanac/index.db-shm
.almanac/logs/
.almanac/.capture-*
.almanac/.bootstrap-*
.almanac/.ingest-*
